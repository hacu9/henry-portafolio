---
/**
 * LEDGER, every decision has a cost.
 *
 * Henry is unusual in that he pays for his own users: he runs the ad campaigns
 * for the products he engineers. So this direction is an account book. Each
 * technical decision is an entry with a debit, what it cost him, and a
 * credit, what it bought. Thermal-print register, ruled lines, tabular numbers.
 *
 * The costs are real ones already written in the case studies (owning uptime
 * after leaving managed hosting, vendor lock-in on the OTP path). Nothing here
 * invents a figure.
 */
import Base from '../../../layouts/Base.astro';
import TechWall from '../../../components/TechWall.astro';
import TechRow from '../../../components/TechRow.astro';
import ContactSwitch from '../../../components/ContactSwitch.astro';
import { LANGS, t, tl, OTHER_LANG, LANG_LABEL, path , asset} from '../../../i18n/types';
import type { Lang } from '../../../i18n/types';
import { ui } from '../../../i18n/ui';
import { profile } from '../../../data/profile';
import { leadProjects, supportingProjects, STATUS_LABEL, projectName } from '../../../data/projects';
import { stackGroups } from '../../../data/stack';
import { timeline, presentLabel } from '../../../data/timeline';
import { COARSE_TIMELINE_DATES } from '../../../data/config';
import '../../../styles/reset.css';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const other = OTHER_LANG[lang];
const altHref = path(base, other, 'ledger');
const indexHref = path(base, lang);

const L = {
  account: { en: 'ACCOUNT', es: 'CUENTA' },
  entry: { en: 'ENTRY', es: 'ASIENTO' },
  bought: { en: 'BOUGHT', es: 'COMPRÓ' },
  paid: { en: 'PAID', es: 'PAGÓ' },
  balance: { en: 'BALANCE', es: 'BALANCE' },
  totals: { en: 'TOTALS', es: 'TOTALES' },
};
---

<Base
  lang={lang}
  title={`${profile.name}, ${t(profile.title, lang)}`}
  description={t(profile.summary, lang)}
  slug="ledger"
  themeColor="#0C1412"
  grain={false}
>
  <a class="skip" href="#main">{t(ui.skipToContent, lang)}</a>

  <header class="bar">
    <a class="mark" href={indexHref}>{L.account[lang]} · {profile.name}</a>
    <div class="tools">
      <a href={altHref} hreflang={other} lang={other}>{LANG_LABEL[other]}</a>
      <button data-theme-toggle type="button">
        <span class="visually-hidden">{t(ui.toggleTheme, lang)}</span>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </header>

  <main id="main">
    <section class="head">
      <p class="k">{t(profile.title, lang)} · {t(profile.experience, lang)} · {t(profile.location, lang)}</p>
      <h1>{t(profile.positioning, lang)}</h1>
        <p class="hero-lede">{t(profile.lede, lang)}</p>
      <div class="tot">
        <div><span class="k">{lang === 'es' ? 'Años' : 'Years'}</span><b><span data-count="8" data-suffix="+">0</span></b></div>
        <div><span class="k">{lang === 'es' ? 'Productos' : 'Products'}</span><b><span data-count="4">0</span></b></div>
        <div><span class="k">{lang === 'es' ? 'En producción' : 'In production'}</span><b><span data-count="1">0</span></b></div>
      </div>
    </section>

    <section id="approach" class="rule-block">
      <p class="k">{t(ui.howIWork, lang)}</p>
      <h2>{t(profile.thesis.lead, lang)}</h2>
      <div class="cols" data-stagger>
        {tl(profile.thesis.body, lang).map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section id="work">
      {
        leadProjects.map((p, i) => (
          <article class="acct" data-camera>
            <div class="acct-head">
              <span class="no">{String(i + 1).padStart(3, '0')}</span>
              <h2>{projectName(p, lang)}</h2>
              <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              <span class="per">{p.period}</span>
            </div>
            <p class="tag">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              {p.shots && (
                <div class="shots">
                  {p.shots.map((sh) => (
                    <img src={asset(base, sh.src)} alt={t(sh.alt, lang)} loading="lazy" decoding="async" />
                  ))}
                </div>
              )}

            <div class="ctx">
              <p>{t(p.problem, lang)}</p>
            </div>

            {/* The book itself: each hard call as a double entry. */}
            <table class="book">
              <caption class="visually-hidden">
                {p.decisions.length > 1 ? t(ui.theDecisions, lang) : t(ui.theDecision, lang)}
              </caption>
              <thead>
                <tr>
                  <th scope="col">{L.entry[lang]}</th>
                  <th scope="col">{L.bought[lang]}</th>
                  <th scope="col">{L.paid[lang]}</th>
                </tr>
              </thead>
              <tbody>
                {p.decisions.map((d) => (
                  <tr>
                    <th scope="row">{t(d.title, lang)}</th>
                    <td colspan="2">{t(d.body, lang)}</td>
                  </tr>
                ))}
              </tbody>
            </table>

            <div class="built">
              <p class="k">{t(ui.whatIBuilt, lang)}</p>
              <ul>{tl(p.built, lang).map((b) => <li>{b}</li>)}</ul>
            </div>

            <p class="bal">
              <span class="k">{L.balance[lang]}</span>
              {t(p.outcome, lang)}
            </p>
            <TechRow items={p.stack} size="sm" />
          </article>
        ))
      }
    </section>

    <section class="rule-block">
      <p class="k">{t(ui.supportingWork, lang)}</p>
      <div class="minis" data-stagger>
        {
          supportingProjects.map((p) => (
            <article class="mini">
              <h3>
                {projectName(p, lang)}
                <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              </h3>
              <p class="tag">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              <p>{t(p.problem, lang)}</p>
              <p class="inline-call">
                <strong>{t(p.decisions[0].title, lang)}.</strong> {t(p.decisions[0].body, lang)}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="rule-block">
      <p class="k">{t(ui.whatIUse, lang)}</p>
      <TechWall />
      {
        stackGroups.map((g) => (
          <div class="sg">
            <h3>{t(g.label, lang)}</h3>
            <p class="items">{g.items.join('  ·  ')}</p>
            {g.note && <p class="note">{t(g.note, lang)}</p>}
          </div>
        ))
      }
    </section>

    <section class="rule-block">
      <p class="k">{t(ui.timeline, lang)}</p>
      <ol class="record">
        {
          timeline.map((e) => (
            <li>
              <span class="when">
                {COARSE_TIMELINE_DATES
                  ? e.yearsOnly
                  : `${e.from} to ${e.to === 'Present' ? t(presentLabel, lang) : e.to}`}
              </span>
              <span class="what">
                <strong>{t(e.role, lang)}</strong>
                <span>{e.org}</span>
                {e.detail && <span class="det">{t(e.detail, lang)}</span>}{e.highlights && (<ul class="role-hl">{tl(e.highlights, lang).map((h) => <li>{h}</li>)}</ul>)}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="contact" class="closing">
      <div class="contact-id"><img class="portrait" src={asset(base, profile.photo)} alt={t(profile.photoAlt, lang)} width="72" height="72" loading="lazy" />
        <p class="k">{t(ui.getInTouch, lang)}</p></div>
      {t(ui.contactLede, lang) && <h2>{t(ui.contactLede, lang)}</h2>}
      <ContactSwitch lang={lang} />
    </section>
  </main>

  <footer class="foot">
    <span>{L.totals[lang]} · {profile.name}</span>
    <a href={indexHref}>{t(ui.backToIndex, lang)}</a>
  </footer>
</Base>

<style>
  :root {
    --ground: #f4f2ec;
    --raise: #fffdf8;
    --ink: #14201d;
    --ink-2: #3f524d;
    --dim: #7b8a85;
    --line: #c8d2ce;
    --accent: #1f6f63;
    --focus: #1f6f63;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --shell: 70rem;
    --read: 36rem;
    --pad: clamp(1rem, 3vw, 2.5rem);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #0c1412;
      --raise: #121b19;
      --ink: #dfe9e6;
      --ink-2: #a3b5b0;
      --dim: #6d817b;
      --line: #1e2a27;
      --accent: #5fd3c0;
    }
  }
  :global(:root[data-theme='dark']) {
    --ground: #0c1412;
    --raise: #121b19;
    --ink: #dfe9e6;
    --ink-2: #a3b5b0;
    --dim: #6d817b;
    --line: #1e2a27;
    --accent: #5fd3c0;
  }
  :global(:root[data-theme='light']) {
    --ground: #f4f2ec;
    --raise: #fffdf8;
    --ink: #14201d;
    --ink-2: #3f524d;
    --dim: #7b8a85;
    --line: #c8d2ce;
    --accent: #1f6f63;
  }

  :global(body) {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.66;
  }

  .k {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem var(--pad);
    background: var(--ground);
    border-bottom: 2px dashed var(--line);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .bar a { text-decoration: none; }
  .mark { font-weight: 700; }
  .tools { margin-inline-start: auto; display: flex; gap: 0.8rem; align-items: center; color: var(--dim); }
  .tools a:hover, .tools button:hover { color: var(--accent); }

  .head {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(2.5rem, 7vw, 4rem) var(--pad) clamp(1.5rem, 3vw, 2.2rem);
    display: grid;
    gap: 1.2rem;
  }
  .head h1 {
    font-family: var(--sans);
    font-size: clamp(1.35rem, 2.9vw, 2rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
    font-weight: 600;
    max-width: 40ch;
    margin: 0;
    text-wrap: pretty;
  }
  .tot {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    border-block: 2px dashed var(--line);
    padding-block: 0.8rem;
    max-width: 34rem;
  }
  .tot div { display: grid; gap: 0.15rem; }
  .tot b { font-size: 1.6rem; color: var(--accent); font-variant-numeric: tabular-nums; line-height: 1; }

  .rule-block {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3rem) var(--pad);
    border-top: 1px solid var(--line);
    display: grid;
    gap: 1rem;
  }
  .rule-block h2 {
    font-family: var(--sans);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    letter-spacing: -0.025em;
    font-weight: 700;
    margin: 0;
  }
  .cols { display: grid; gap: 1rem; color: var(--ink-2); }
  @media (min-width: 860px) { .cols { grid-template-columns: repeat(3, 1fr); gap: 1.8rem; } }
  .caveat { border-top: 1px dashed var(--line); padding-top: 0.8rem; color: var(--dim); max-width: 46rem; display: grid; gap: 0.35rem; }

  /* --------------------------------------------------------------- accounts */
  .acct {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3rem) var(--pad);
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.9rem;
  }
  .acct-head { display: flex; align-items: baseline; gap: 0.9rem; flex-wrap: wrap; }
  .no { color: var(--accent); font-variant-numeric: tabular-nums; }
  .acct h2 {
    font-family: var(--sans);
    font-size: clamp(1.4rem, 3.2vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .per { margin-inline-start: auto; color: var(--dim); font-size: 0.6875rem; }
  .st {
    font-size: 0.5625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    padding: 0.06rem 0.36rem;
  }
  .st-live { color: var(--accent); }
  .st-building, .st-ongoing, .st-delivered { color: var(--dim); }
  .tag { color: var(--dim); font-size: 0.6875rem; }
  .ctx p { color: var(--ink-2); max-width: 48rem; }

  .book { width: 100%; border-collapse: collapse; margin-block: 0.4rem; }
  .book thead th {
    text-align: left;
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    font-weight: 500;
    border-bottom: 2px solid var(--line);
    padding: 0.4rem 0.6rem 0.4rem 0;
  }
  .book tbody th {
    text-align: left;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--ink);
    padding: 0.7rem 1.2rem 0.7rem 0;
    vertical-align: top;
    border-bottom: 1px dashed var(--line);
    width: 34%;
    line-height: 1.35;
  }
  .book tbody td {
    color: var(--ink-2);
    padding: 0.7rem 0;
    vertical-align: top;
    border-bottom: 1px dashed var(--line);
  }
  @media (max-width: 720px) {
    .book, .book thead, .book tbody, .book tr, .book th, .book td { display: block; width: auto; }
    .book thead { display: none; }
    .book tbody th { border-bottom: 0; padding-bottom: 0.2rem; }
  }

  .built { display: grid; gap: 0.4rem; }
  .built ul { display: grid; gap: 0.22rem; list-style: none; padding: 0; color: var(--ink-2); max-width: var(--read); }
  .built li::before { content: '· '; color: var(--accent); }
  .bal {
    border-top: 2px solid var(--ink);
    padding-top: 0.7rem;
    display: grid;
    gap: 0.3rem;
    color: var(--ink);
    max-width: 48rem;
  }
  .deps { color: var(--dim); font-size: 0.625rem; letter-spacing: 0.06em; }

  .minis { display: grid; gap: 1.4rem; }
  @media (min-width: 820px) { .minis { grid-template-columns: 1fr 1fr; } }
  .mini { display: grid; gap: 0.4rem; align-content: start; border-top: 1px dashed var(--line); padding-top: 0.8rem; }
  .mini h3 { font-family: var(--sans); font-size: 1.1rem; font-weight: 700; display: flex; gap: 0.7rem; align-items: center; flex-wrap: wrap; margin: 0; }
  .mini p { color: var(--ink-2); }
  .inline-call strong { color: var(--ink); }

  .sg { display: grid; gap: 0.3rem; border-top: 1px dashed var(--line); padding-top: 0.7rem; }
  .sg h3 { font-size: 0.625rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); font-weight: 500; margin: 0; }
  .items { color: var(--ink-2); line-height: 1.9; }
  .note { color: var(--dim); max-width: var(--read); }

  .record { display: grid; list-style: none; padding: 0; margin: 0; }
  .record li { display: grid; gap: 0.05rem 1.5rem; padding: 0.6rem 0; border-top: 1px dashed var(--line); }
  @media (min-width: 660px) { .record li { grid-template-columns: 11rem 1fr; } }
  .when { color: var(--dim); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; font-variant-numeric: tabular-nums; }
  .what { display: grid; gap: 0.02rem; }
  .what strong { font-family: var(--sans); font-size: 0.95rem; }
  .what span { color: var(--ink-2); }
  .what .det { color: var(--dim); }

  .closing {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 5rem) var(--pad);
    border-top: 3px double var(--ink);
    display: grid;
    gap: 1rem;
  }
  .closing h2 { font-family: var(--sans); font-size: clamp(1.3rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.025em; max-width: 26ch; margin: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 1.4rem; }
  .links a { color: var(--accent); text-underline-offset: 4px; }

  .foot {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.2rem var(--pad) 3rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 2px dashed var(--line);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .foot a { color: var(--accent); }

  .verify-link {
    color: var(--accent, currentColor);
    text-underline-offset: 3px;
    font-weight: 600;
    white-space: nowrap;
  }
  .verify-link:hover { filter: brightness(1.15); }

  .role-hl {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }
  .role-hl li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.875rem;
    color: var(--ink-2, currentColor);
    line-height: 1.5;
  }
  .role-hl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--accent, currentColor);
  }

  .contact-id { display: flex; align-items: center; gap: 0.9rem; }

  /* Portrait beside the contact heading, a face where someone decides to write. */
  .portrait {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent, currentColor);
    flex: none;
  }
  /* Product screenshots. Phone-shaped, so they scroll rather than squash. */
  .shots {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
    margin-block: 0.3rem;
    scroll-snap-type: x mandatory;
  }
  .shots img {
    width: clamp(140px, 26vw, 210px);
    height: auto;
    flex: none;
    border-radius: 12px;
    scroll-snap-align: start;
    background: var(--raise, transparent);
  }

  .hero-lede {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.5;
    color: var(--ink-2, currentColor);
    max-width: 46ch;
    margin-top: 0.9rem;
    text-wrap: pretty;
  }
</style>
