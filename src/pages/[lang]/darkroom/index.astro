---
/**
 * DARKROOM — Iventions' lighting model taken literally.
 *
 * The page is dark and the content is dimmed until the pointer lights it. That
 * is the whole mechanic: a guided walk-through rather than a grid, where the
 * reader's attention is a physical thing moving across the page.
 *
 * Accessibility is the obvious hazard, so the dimming is opt-in by capability:
 * it applies only with a fine pointer and no reduced-motion preference. On
 * touch, keyboard and reduced-motion the page is simply legible, and focus
 * lights a card the same way hover does.
 */
import Base from '../../../layouts/Base.astro';
import TechWall from '../../../components/TechWall.astro';
import ContactSwitch from '../../../components/ContactSwitch.astro';
import { LANGS, t, tl, OTHER_LANG, LANG_LABEL, path , asset} from '../../../i18n/types';
import type { Lang } from '../../../i18n/types';
import { ui } from '../../../i18n/ui';
import { profile } from '../../../data/profile';
import { leadProjects, supportingProjects, STATUS_LABEL, projectName } from '../../../data/projects';
import { stackGroups } from '../../../data/stack';
import { timeline, presentLabel } from '../../../data/timeline';
import { COARSE_TIMELINE_DATES } from '../../../data/config';
import '../../../styles/reset.css';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const other = OTHER_LANG[lang];
const altHref = path(base, other, 'darkroom');
const indexHref = path(base, lang);
---

<Base
  lang={lang}
  title={`${profile.name} — ${t(profile.title, lang)}`}
  description={t(profile.positioning, lang)}
  slug="darkroom"
  themeColor="#07070A"
  scrollDuration={1.2}
>
  <a class="skip" href="#main">{t(ui.skipToContent, lang)}</a>
  <div class="lamp" aria-hidden="true"></div>

  <header class="bar">
    <a class="mark" href={indexHref}>{profile.name}</a>
    <nav>
      <a href="#work">{t(ui.work, lang)}</a>
      <a href="#approach">{t(ui.about, lang)}</a>
      <a href="#contact">{t(ui.contact, lang)}</a>
    </nav>
    <div class="tools">
      <a href={altHref} hreflang={other} lang={other}>{LANG_LABEL[other]}</a>
      <button data-theme-toggle type="button">
        <span class="visually-hidden">{t(ui.toggleTheme, lang)}</span>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </header>

  <main id="main">
    <section class="open">
      <p class="kick">{t(profile.title, lang)} — {t(profile.experience, lang)}</p>
      <h1>{profile.name}</h1>
      <p class="lede">{t(profile.positioning, lang)}</p>
      <p class="kick foot-note">{t(profile.location, lang)} · {t(profile.workingStyle, lang)}</p>
      <p class="hint" aria-hidden="true">
        {lang === 'es' ? 'Mueve el cursor para iluminar' : 'Move your cursor to light the page'}
      </p>
    </section>

    <section id="approach" class="band">
      <p class="kick" data-rise>{t(ui.howIWork, lang)}</p>
      <div class="lit" data-camera>
        <h2>{t(profile.thesis.lead, lang)}</h2>
        <div class="cols">
          {tl(profile.thesis.body, lang).map((p) => <p>{p}</p>)}
        </div>
        <p class="counter">
          <span class="kick">{t(ui.theTradeoff, lang)}</span>
          {t(profile.thesis.tradeoff, lang)}
        </p>
      </div>
    </section>

    <section id="work" class="band">
      <p class="kick" data-rise>{t(ui.leadWork, lang)}</p>
      {
        leadProjects.map((p, i) => (
          <article class="plate lit" tabindex="0" data-camera>
            <div class="plate-head">
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{projectName(p, lang)}</h3>
              <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
            </div>
            <p class="tag">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              {p.shots && (
                <div class="shots">
                  {p.shots.map((sh) => (
                    <img src={asset(base, sh.src)} alt={t(sh.alt, lang)} loading="lazy" decoding="async" />
                  ))}
                </div>
              )}

            <div class="beats">
              <div>
                <p class="kick">{t(ui.theProblem, lang)}</p>
                <p>{t(p.problem, lang)}</p>
              </div>
              <div>
                <p class="kick">{t(ui.whatIBuilt, lang)}</p>
                <ul>{tl(p.built, lang).map((b) => <li>{b}</li>)}</ul>
              </div>
              <div class="wide">
                <p class="kick">
                  {p.decisions.length > 1 ? t(ui.theDecisions, lang) : t(ui.theDecision, lang)}
                </p>
                {p.decisions.map((d) => (
                  <div class="call">
                    <h4>{t(d.title, lang)}</h4>
                    <p>{t(d.body, lang)}</p>
                  </div>
                ))}
              </div>
              <div class="wide">
                <p class="kick">{t(ui.theOutcome, lang)}</p>
                <p class="out">{t(p.outcome, lang)}</p>
              </div>
            </div>
            <p class="stackline">{p.stack.join('  ·  ')}</p>
          </article>
        ))
      }
    </section>

    <section class="band">
      <p class="kick" data-rise>{t(ui.supportingWork, lang)}</p>
      <div class="minis" data-stagger>
        {
          supportingProjects.map((p) => (
            <article class="plate mini lit" tabindex="0">
              <h3>
                {projectName(p, lang)}
                <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              </h3>
              <p class="tag">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              <p>{t(p.problem, lang)}</p>
              <p class="inline-call">
                <strong>{t(p.decisions[0].title, lang)}.</strong> {t(p.decisions[0].body, lang)}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="band">
      <p class="kick" data-rise>{t(ui.whatIUse, lang)}</p>
      <TechWall />
      <div class="lit" data-camera>
        {
          stackGroups.map((g) => (
            <div class="sg">
              <h3>{t(g.label, lang)}</h3>
              <p class="items">{g.items.join('  ·  ')}</p>
              {g.note && <p class="note">{t(g.note, lang)}</p>}
            </div>
          ))
        }
      </div>
    </section>

    <section class="band">
      <p class="kick" data-rise>{t(ui.timeline, lang)}</p>
      <ol class="record lit" data-camera>
        {
          timeline.map((e) => (
            <li>
              <span class="when">
                {COARSE_TIMELINE_DATES
                  ? e.yearsOnly
                  : `${e.from} — ${e.to === 'Present' ? t(presentLabel, lang) : e.to}`}
              </span>
              <span class="what">
                <strong>{t(e.role, lang)}</strong>
                <span>{e.org}</span>
                {e.detail && <span class="det">{t(e.detail, lang)}</span>}{e.highlights && (<ul class="role-hl">{tl(e.highlights, lang).map((h) => <li>{h}</li>)}</ul>)}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="contact" class="band close">
      <div class="contact-id"><img class="portrait" src={asset(base, profile.photo)} alt={t(profile.photoAlt, lang)} width="72" height="72" loading="lazy" />
        <p class="kick">{t(ui.getInTouch, lang)}</p></div>
      {t(ui.contactLede, lang) && <h2 class="big">{t(ui.contactLede, lang)}</h2>}
      <ContactSwitch lang={lang} />
    </section>
  </main>

  <footer class="foot">
    <span>{profile.name} · {t(profile.location, lang)}</span>
    <a href={indexHref}>{t(ui.backToIndex, lang)}</a>
  </footer>
</Base>

<style>
  /* Committed to a single dark world. A darkroom with the lights on is a room. */
  :root {
    --ground: #07070a;
    --raise: #0e0e13;
    --ink: #ece8e1;
    --ink-2: #9c968e;
    --dim: #625d57;
    --line: #1d1d24;
    --accent: #e8b23f;
    --focus: #e8b23f;
    --grain-opacity: 0.06;
    --display: 'Iowan Old Style', 'Charter', 'Palatino Linotype', Georgia, serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    --shell: 70rem;
    --read: 36rem;
    --pad: clamp(1.15rem, 4vw, 3rem);
  }
  /* The light theme lifts the room without abandoning the idea. */
  :global(:root[data-theme='light']) {
    --ground: #14131a;
    --raise: #1c1b23;
    --ink: #f4f1ea;
    --ink-2: #b3aca2;
    --dim: #797269;
    --line: #2a2932;
    --accent: #f0c25c;
  }

  :global(body) {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.65;
  }

  /* The lamp itself: one fixed radial that follows the pointer. */
  .lamp {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    background: radial-gradient(
      30rem 30rem at var(--lx, 50%) var(--ly, 40%),
      color-mix(in srgb, var(--accent) 13%, transparent),
      transparent 68%
    );
  }
  :global(body.lit-on) .lamp {
    opacity: 1;
  }

  main,
  .bar,
  .foot {
    position: relative;
    z-index: 1;
  }

  .kick {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 1.4rem;
    padding: 0.8rem var(--pad);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    background: color-mix(in srgb, var(--ground) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar a {
    text-decoration: none;
  }
  .bar .mark {
    color: var(--ink);
    font-weight: 700;
  }
  .bar nav {
    display: flex;
    gap: 1.1rem;
    margin-inline-start: auto;
  }
  .bar nav a:hover,
  .tools a:hover,
  .tools button:hover {
    color: var(--accent);
  }
  .tools {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }
  @media (max-width: 680px) {
    .bar nav {
      display: none;
    }
  }

  .open {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(4rem, 16vh, 9rem) var(--pad) clamp(3rem, 8vh, 5rem);
    display: grid;
    gap: 1.1rem;
  }
  .open h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(3rem, 11vw, 8.5rem);
    line-height: 0.92;
    letter-spacing: -0.038em;
    margin: 0;
  }
  .lede {
    font-size: clamp(1.05rem, 1.9vw, 1.35rem);
    color: var(--ink-2);
    max-width: 34ch;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .foot-note {
    border-top: 1px solid var(--line);
    padding-top: 0.9rem;
    margin-top: 0.5rem;
  }
  .hint {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.55;
    animation: blink 3.4s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.12; }
  }
  @media (prefers-reduced-motion: reduce), (pointer: coarse) {
    .hint {
      display: none;
    }
  }

  .band {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(2.5rem, 7vw, 5rem) var(--pad);
    border-top: 1px solid var(--line);
    display: grid;
    gap: 1.5rem;
  }

  /*
   * The dimming. Only where a fine pointer exists and motion is welcome —
   * otherwise the page just reads normally.
   */
  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .lit {
      opacity: 0.34;
      filter: saturate(0.55);
      transition: opacity 0.55s ease, filter 0.55s ease, border-color 0.55s ease;
    }
    .lit:hover,
    .lit:focus-visible,
    .lit:focus-within {
      opacity: 1;
      filter: none;
    }
  }

  .plate {
    background: var(--raise);
    border: 1px solid var(--line);
    padding: clamp(1.2rem, 3vw, 2rem);
    display: grid;
    gap: 1rem;
  }
  .plate + .plate {
    margin-top: 1.2rem;
  }
  .plate:hover,
  .plate:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }
  .plate-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.7rem;
  }
  .num {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .plate h3 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.6rem, 3.4vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }
  .st {
    margin-inline-start: auto;
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    padding: 0.1rem 0.38rem;
    white-space: nowrap;
  }
  .st-live { color: #6fd39b; }
  .st-building { color: var(--accent); }
  .st-ongoing, .st-delivered { color: var(--dim); }

  .tag {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--dim);
    margin: -0.5rem 0 0;
  }
  .beats {
    display: grid;
    gap: 1.4rem;
  }
  @media (min-width: 860px) {
    .beats {
      grid-template-columns: 1fr 1fr;
      gap: 1.6rem 2.5rem;
    }
    .beats .wide {
      grid-column: 1 / -1;
    }
  }
  .beats > div {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .beats p,
  .beats ul {
    color: var(--ink-2);
    max-width: var(--read);
  }
  .beats ul {
    display: grid;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
  }
  .beats li::before {
    content: '— ';
    color: var(--accent);
  }
  .call {
    border-left: 2px solid var(--accent);
    padding-left: 0.9rem;
    display: grid;
    gap: 0.35rem;
    max-width: 46rem;
  }
  .call + .call {
    margin-top: 0.8rem;
  }
  .call h4 {
    font-size: 1rem;
    font-weight: 650;
    color: var(--ink);
    margin: 0;
    line-height: 1.35;
  }
  .out {
    color: var(--ink) !important;
    max-width: 46rem !important;
  }
  .stackline {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--dim);
    border-top: 1px solid var(--line);
    padding-top: 0.8rem;
  }

  .minis {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 820px) {
    .minis {
      grid-template-columns: 1fr 1fr;
    }
  }
  .mini h3 {
    font-size: 1.3rem;
    display: flex;
    gap: 0.7rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .mini p {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .inline-call strong {
    color: var(--ink);
  }

  .cols {
    display: grid;
    gap: 1rem;
    color: var(--ink-2);
  }
  @media (min-width: 860px) {
    .cols {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.8rem;
    }
  }
  .band h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 0.4rem;
  }
  .counter {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    color: var(--dim);
    max-width: var(--read);
    display: grid;
    gap: 0.4rem;
    font-size: 0.9375rem;
  }

  .sg {
    display: grid;
    gap: 0.4rem;
    border-top: 1px solid var(--line);
    padding-block: 0.9rem;
  }
  .sg h3 {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin: 0;
  }
  .items {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    line-height: 1.9;
  }
  .note {
    color: var(--dim);
    font-size: 0.875rem;
    max-width: var(--read);
  }

  .record {
    display: grid;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .record li {
    display: grid;
    gap: 0.1rem 2rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 660px) {
    .record li {
      grid-template-columns: 11rem 1fr;
    }
  }
  .when {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
    padding-top: 0.3rem;
  }
  .what {
    display: grid;
    gap: 0.05rem;
  }
  .what span {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .what .det {
    color: var(--dim);
    font-size: 0.875rem;
  }

  .close {
    text-align: left;
  }
  .big {
    font-size: clamp(1.9rem, 5vw, 3.6rem);
    max-width: 17ch;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    font-family: var(--mono);
    font-size: 0.9375rem;
    margin-top: 0.6rem;
  }
  .links a {
    color: var(--accent);
    text-underline-offset: 5px;
  }

  .foot {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.5rem var(--pad) 3rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .foot a {
    color: var(--accent);
  }

  .verify-link {
    color: var(--accent, currentColor);
    text-underline-offset: 3px;
    font-weight: 600;
    white-space: nowrap;
  }
  .verify-link:hover { filter: brightness(1.15); }

  .role-hl {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }
  .role-hl li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.875rem;
    color: var(--ink-2, currentColor);
    line-height: 1.5;
  }
  .role-hl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--accent, currentColor);
  }

  .contact-id { display: flex; align-items: center; gap: 0.9rem; }

  /* Portrait beside the contact heading — a face where someone decides to write. */
  .portrait {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent, currentColor);
    flex: none;
  }
  /* Product screenshots. Phone-shaped, so they scroll rather than squash. */
  .shots {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
    margin-block: 0.3rem;
    scroll-snap-type: x mandatory;
  }
  .shots img {
    width: clamp(140px, 26vw, 210px);
    height: auto;
    flex: none;
    border-radius: 12px;
    scroll-snap-align: start;
    background: var(--raise, transparent);
  }
</style>

<script>
  // The lamp follows the pointer. It turns on only once the pointer has
  // actually moved, so a touch or keyboard visitor never sees a half-lit page
  // waiting for an input they will not give.
  const fine = window.matchMedia('(pointer: fine)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fine && !reduce) {
    let x = window.innerWidth / 2;
    let y = window.innerHeight * 0.4;
    let tx = x;
    let ty = y;
    let on = false;

    window.addEventListener(
      'pointermove',
      (e) => {
        tx = e.clientX;
        ty = e.clientY;
        if (!on) {
          on = true;
          document.body.classList.add('lit-on');
        }
      },
      { passive: true },
    );

    const frame = () => {
      // Lag the lamp behind the cursor so the light has weight.
      x += (tx - x) * 0.12;
      y += (ty - y) * 0.12;
      document.documentElement.style.setProperty('--lx', `${(x / window.innerWidth) * 100}%`);
      document.documentElement.style.setProperty('--ly', `${(y / window.innerHeight) * 100}%`);
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>
