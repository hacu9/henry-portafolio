---
/**
 * DECK — the work, stacked and dealt.
 *
 * Projects are physical cards in a stack. As you scroll, the top card lifts
 * away and the next comes forward. Built entirely from position: sticky and a
 * scroll-driven scale, so the whole effect is a handful of CSS rules and one
 * short observer — no library, and nothing that reflows.
 *
 * The reason this direction exists: it is the only one of the twelve that is
 * BETTER on a phone than on a desktop, because a stack of cards is a native
 * mobile idiom. Every other direction is a desktop design that survives mobile.
 */
import Base from '../../../layouts/Base.astro';
import ContactForm from '../../../components/ContactForm.astro';
import { LANGS, t, tl, OTHER_LANG, LANG_LABEL, path , asset} from '../../../i18n/types';
import type { Lang } from '../../../i18n/types';
import { ui } from '../../../i18n/ui';
import { profile } from '../../../data/profile';
import { leadProjects, supportingProjects, STATUS_LABEL, projectName } from '../../../data/projects';
import { stackGroups } from '../../../data/stack';
import { timeline, presentLabel } from '../../../data/timeline';
import { COARSE_TIMELINE_DATES } from '../../../data/config';
import '../../../styles/reset.css';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const other = OTHER_LANG[lang];
const altHref = path(base, other, 'deck');
const indexHref = path(base, lang);
---

<Base
  lang={lang}
  title={`${profile.name} — ${t(profile.title, lang)}`}
  description={t(profile.positioning, lang)}
  slug="deck"
  themeColor="#120D0C"
>
  <a class="skip" href="#main">{t(ui.skipToContent, lang)}</a>

  <header class="bar">
    <a class="mark" href={indexHref}>{profile.name}</a>
    <div class="tools">
      <a href={altHref} hreflang={other} lang={other}>{LANG_LABEL[other]}</a>
      <button data-theme-toggle type="button">
        <span class="visually-hidden">{t(ui.toggleTheme, lang)}</span>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <p class="k">{t(profile.title, lang)} · {t(profile.experience, lang)}</p>
      <h1>{t(profile.positioning, lang)}</h1>
      <p class="loc">{t(profile.location, lang)} · {t(profile.workingStyle, lang)}</p>
    </section>

    <!-- The stack. Each card sticks, then the next slides over it. -->
    <section id="work" class="stack">
      {
        leadProjects.map((p, i) => (
          <article class="card" style={`--i:${i}; --z:${i + 1}`}>
            <div class="card-in">
              <div class="card-head">
                <span class="pip" aria-hidden="true">{String(i + 1)}/{leadProjects.length}</span>
                <h2>{projectName(p, lang)}</h2>
                <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              </div>
              <p class="tag">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              {p.shots && (
                <div class="shots">
                  {p.shots.map((sh) => (
                    <img src={asset(base, sh.src)} alt={t(sh.alt, lang)} loading="lazy" decoding="async" />
                  ))}
                </div>
              )}

              <div class="card-body">
                <div>
                  <p class="k">{t(ui.theProblem, lang)}</p>
                  <p>{t(p.problem, lang)}</p>
                </div>
                <div>
                  <p class="k">{t(ui.whatIBuilt, lang)}</p>
                  <ul>{tl(p.built, lang).map((b) => <li>{b}</li>)}</ul>
                </div>
                <div class="wide">
                  <p class="k">
                    {p.decisions.length > 1 ? t(ui.theDecisions, lang) : t(ui.theDecision, lang)}
                  </p>
                  {p.decisions.map((d) => (
                    <div class="call">
                      <h3>{t(d.title, lang)}</h3>
                      <p>{t(d.body, lang)}</p>
                    </div>
                  ))}
                </div>
                <div class="wide">
                  <p class="k">{t(ui.theOutcome, lang)}</p>
                  <p class="out">{t(p.outcome, lang)}</p>
                </div>
              </div>
              <p class="deps">{p.stack.join('  ·  ')}</p>
            </div>
          </article>
        ))
      }
    </section>

    <section id="approach" class="blk">
      <p class="k" data-rise>{t(ui.howIWork, lang)}</p>
      <div data-camera>
        <h2 class="big">{t(profile.thesis.lead, lang)}</h2>
        <div class="cols" data-stagger>
          {tl(profile.thesis.body, lang).map((p) => <p>{p}</p>)}
        </div>
        <p class="caveat">
          <span class="k">{t(ui.theTradeoff, lang)}</span>
          {t(profile.thesis.tradeoff, lang)}
        </p>
      </div>
    </section>

    <section class="blk">
      <p class="k" data-rise>{t(ui.supportingWork, lang)}</p>
      <div class="minis" data-stagger>
        {
          supportingProjects.map((p) => (
            <article class="mini spot">
              <h3>
                {projectName(p, lang)}
                <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              </h3>
              <p class="tag">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              <p>{t(p.problem, lang)}</p>
              <p class="inline-call">
                <strong>{t(p.decisions[0].title, lang)}.</strong> {t(p.decisions[0].body, lang)}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="blk">
      <p class="k" data-rise>{t(ui.whatIUse, lang)}</p>
      <div class="stacks" data-stagger>
        {
          stackGroups.map((g) => (
            <div class="sg">
              <h3>{t(g.label, lang)}</h3>
              <p class="items">{g.items.join('  ·  ')}</p>
              {g.note && <p class="note">{t(g.note, lang)}</p>}
            </div>
          ))
        }
      </div>
    </section>

    <section class="blk">
      <p class="k" data-rise>{t(ui.timeline, lang)}</p>
      <ol class="record" data-camera>
        {
          timeline.map((e) => (
            <li>
              <span class="when">
                {COARSE_TIMELINE_DATES
                  ? e.yearsOnly
                  : `${e.from} — ${e.to === 'Present' ? t(presentLabel, lang) : e.to}`}
              </span>
              <span class="what">
                <strong>{t(e.role, lang)}</strong>
                <span>{e.org}</span>
                {e.detail && <span class="det">{t(e.detail, lang)}</span>}{e.highlights && (<ul class="role-hl">{tl(e.highlights, lang).map((h) => <li>{h}</li>)}</ul>)}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="contact" class="blk closing spot" data-camera>
      <div class="contact-id"><img class="portrait" src={asset(base, profile.photo)} alt={t(profile.photoAlt, lang)} width="72" height="72" loading="lazy" />
        <p class="k">{t(ui.getInTouch, lang)}</p></div>
      {t(ui.contactLede, lang) && <h2 class="big">{t(ui.contactLede, lang)}</h2>}
      <p class="links">
        <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.linkedinUrl} rel="me noopener">LinkedIn</a>
        <a href={profile.githubUrl} rel="me noopener">GitHub</a>
      </p>
      <ContactForm lang={lang} />
    </section>
  </main>

  <footer class="foot">
    <span>{profile.name} · {t(profile.location, lang)}</span>
    <a href={indexHref}>{t(ui.backToIndex, lang)}</a>
  </footer>
</Base>

<style>
  :root {
    --ground: #f6f1ee;
    --raise: #ffffff;
    --ink: #1a1210;
    --ink-2: #4b3d38;
    --dim: #857069;
    --line: #ddd0ca;
    --accent: #a8341f;
    --focus: #a8341f;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    --shell: 62rem;
    --read: 34rem;
    --pad: clamp(1rem, 4vw, 2.5rem);
    --r: 16px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #120d0c;
      --raise: #1c1513;
      --ink: #f0e7e3;
      --ink-2: #bfaea8;
      --dim: #8b7871;
      --line: #2c211e;
      --accent: #ff8a6b;
    }
  }
  :global(:root[data-theme='dark']) {
    --ground: #120d0c;
    --raise: #1c1513;
    --ink: #f0e7e3;
    --ink-2: #bfaea8;
    --dim: #8b7871;
    --line: #2c211e;
    --accent: #ff8a6b;
  }
  :global(:root[data-theme='light']) {
    --ground: #f6f1ee;
    --raise: #ffffff;
    --ink: #1a1210;
    --ink-2: #4b3d38;
    --dim: #857069;
    --line: #ddd0ca;
    --accent: #a8341f;
  }

  :global(body) {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.62;
  }

  .k {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem var(--pad);
    background: color-mix(in srgb, var(--ground) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .bar a { text-decoration: none; }
  .mark { font-weight: 700; }
  .tools { margin-inline-start: auto; display: flex; gap: 0.8rem; align-items: center; color: var(--dim); }
  .tools a:hover, .tools button:hover { color: var(--accent); }

  .hero {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(3rem, 9vh, 5.5rem) var(--pad) clamp(2rem, 5vw, 3rem);
    display: grid;
    gap: 1rem;
  }
  .hero h1 {
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.028em;
    font-weight: 650;
    max-width: 24ch;
    margin: 0;
    text-wrap: pretty;
  }
  .loc { font-family: var(--mono); font-size: 0.6875rem; color: var(--dim); letter-spacing: 0.08em; }

  /* ---------------------------------------------------------------- stack */
  .stack {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--pad);
    display: grid;
    /* No gap: cards must overlap as they stick. */
    gap: 0;
  }
  .card {
    position: sticky;
    /* Each card parks slightly lower, so the stack shows its edges. */
    top: calc(4.5rem + var(--i) * 0.85rem);
    z-index: var(--z);
    padding-bottom: 1.4rem;
  }
  .card-in {
    background: var(--raise);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: clamp(1.2rem, 3.5vw, 2rem);
    display: grid;
    gap: 0.9rem;
    box-shadow: 0 -1px 0 var(--line), 0 18px 40px -28px rgb(0 0 0 / 0.5);
    transform-origin: 50% 0%;
  }
  @media (prefers-reduced-motion: reduce) {
    .card { position: static; }
  }

  .card-head { display: flex; align-items: baseline; gap: 0.9rem; flex-wrap: wrap; }
  .pip { font-family: var(--mono); font-size: 0.6875rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .card h2 {
    font-size: clamp(1.4rem, 3.4vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.032em;
    line-height: 1.05;
    margin: 0;
  }
  .st {
    margin-inline-start: auto;
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .st-live { color: #2c7a52; }
  .st-building { color: var(--accent); }
  .st-ongoing, .st-delivered { color: var(--dim); }
  @media (prefers-color-scheme: dark) { .st-live { color: #66c795; } }
  .tag { font-family: var(--mono); font-size: 0.6875rem; color: var(--dim); margin-top: -0.5rem; }

  .card-body { display: grid; gap: 1.1rem; }
  @media (min-width: 820px) {
    .card-body { grid-template-columns: 1fr 1fr; gap: 1.2rem 2rem; }
    .card-body .wide { grid-column: 1 / -1; }
  }
  .card-body > div { display: grid; gap: 0.4rem; align-content: start; }
  .card-body p, .card-body ul { color: var(--ink-2); font-size: 0.9rem; max-width: var(--read); }
  .card-body ul { display: grid; gap: 0.22rem; list-style: none; padding: 0; }
  .card-body li::before { content: '— '; color: var(--accent); }
  .call { display: grid; gap: 0.25rem; }
  .call + .call { margin-top: 0.6rem; }
  .call h3 { font-size: 0.98rem; font-weight: 650; color: var(--ink); margin: 0; line-height: 1.3; }
  .out { color: var(--ink) !important; }
  .deps {
    font-family: var(--mono);
    font-size: 0.625rem;
    color: var(--dim);
    border-top: 1px solid var(--line);
    padding-top: 0.7rem;
  }

  /* ---------------------------------------------------------------- rest */
  .blk {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--pad);
    border-top: 1px solid var(--line);
    display: grid;
    gap: 1.1rem;
    /* Sits above the parked cards once the stack is done. */
    position: relative;
    z-index: 50;
    background: var(--ground);
  }
  .big { font-size: clamp(1.5rem, 3.6vw, 2.4rem); font-weight: 700; letter-spacing: -0.03em; margin: 0 0 0.8rem; text-wrap: balance; }
  .cols { display: grid; gap: 1rem; color: var(--ink-2); }
  @media (min-width: 860px) { .cols { grid-template-columns: repeat(3, 1fr); gap: 1.8rem; } }
  .caveat { border-top: 1px solid var(--line); padding-top: 0.9rem; margin-top: 1rem; color: var(--dim); max-width: 46rem; display: grid; gap: 0.35rem; font-size: 0.9375rem; }

  .minis { display: grid; gap: 1rem; }
  @media (min-width: 780px) { .minis { grid-template-columns: 1fr 1fr; } }
  .mini {
    --spot-color: var(--accent);
    background: var(--raise);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 1.1rem 1.2rem;
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .mini h3 { font-size: 1.05rem; font-weight: 700; display: flex; gap: 0.7rem; align-items: center; flex-wrap: wrap; margin: 0; }
  .mini h3 .st { margin-inline-start: 0; }
  .mini p { color: var(--ink-2); font-size: 0.9rem; }
  .inline-call strong { color: var(--ink); }

  .stacks { display: grid; gap: 1rem; }
  @media (min-width: 780px) { .stacks { grid-template-columns: 1fr 1fr; } }
  .sg { display: grid; gap: 0.4rem; border-top: 1px solid var(--line); padding-top: 0.8rem; }
  .sg h3 { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); font-weight: 500; margin: 0; }
  .items { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-2); line-height: 1.85; }
  .note { color: var(--dim); font-size: 0.875rem; max-width: var(--read); }

  .record { display: grid; list-style: none; padding: 0; margin: 0; }
  .record li { display: grid; gap: 0.1rem 1.5rem; padding: 0.7rem 0; border-top: 1px solid var(--line); }
  @media (min-width: 640px) { .record li { grid-template-columns: 10rem 1fr; } }
  .when { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); font-variant-numeric: tabular-nums; padding-top: 0.25rem; }
  .what { display: grid; gap: 0.05rem; }
  .what span { color: var(--ink-2); font-size: 0.9rem; }
  .what .det { color: var(--dim); font-size: 0.85rem; }

  .closing { --spot-color: var(--accent); }
  .links { display: flex; flex-wrap: wrap; gap: 1.2rem; align-items: center; font-family: var(--mono); font-size: 0.875rem; }
  .links a { color: var(--accent); text-underline-offset: 4px; }
  .links a.btn,
  .btn {
    background: var(--accent);
    color: var(--ground);
    text-decoration: none;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
  }
  .links a.btn:hover,
  .btn:hover { filter: brightness(1.08); }

  .foot {
    position: relative;
    z-index: 50;
    background: var(--ground);
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.4rem var(--pad) 3rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .foot a { color: var(--accent); }

  .verify-link {
    color: var(--accent, currentColor);
    text-underline-offset: 3px;
    font-weight: 600;
    white-space: nowrap;
  }
  .verify-link:hover { filter: brightness(1.15); }

  .role-hl {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }
  .role-hl li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.875rem;
    color: var(--ink-2, currentColor);
    line-height: 1.5;
  }
  .role-hl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--accent, currentColor);
  }

  .contact-id { display: flex; align-items: center; gap: 0.9rem; }

  /* Portrait beside the contact heading — a face where someone decides to write. */
  .portrait {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent, currentColor);
    flex: none;
  }
  /* Product screenshots. Phone-shaped, so they scroll rather than squash. */
  .shots {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
    margin-block: 0.3rem;
    scroll-snap-type: x mandatory;
  }
  .shots img {
    width: clamp(140px, 26vw, 210px);
    height: auto;
    flex: none;
    border-radius: 12px;
    scroll-snap-align: start;
    background: var(--raise, transparent);
  }
</style>

<script>
  // As a card is covered by the next one, it shrinks and dims slightly. That
  // is what sells the stack as physical rather than as overlapping boxes.
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cards.length && !reduce) {
    let raf = 0;

    const update = () => {
      for (const card of cards) {
        const inner = card.querySelector<HTMLElement>('.card-in');
        if (!inner) continue;
        const rect = card.getBoundingClientRect();
        const parked = parseFloat(getComputedStyle(card).top) || 0;
        // How far past its parking spot the card has been pushed.
        const covered = Math.min(1, Math.max(0, (parked - rect.top) / 420));
        inner.style.transform = `scale(${1 - covered * 0.055})`;
        inner.style.opacity = String(1 - covered * 0.35);
      }
      raf = 0;
    };

    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>
