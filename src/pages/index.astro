---
// GitHub Pages has no server, so the language split happens on the client.
// This page guesses from navigator.language and forwards, with real links
// underneath for anyone without JS or with an unexpected locale.
import { path } from '../i18n/types';

const base = import.meta.env.BASE_URL;
const en = path(base, 'en');
const es = path(base, 'es');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Henry Cabello — Senior Full-Stack Engineer</title>
    <meta
      name="description"
      content="Senior full-stack engineer, 8+ years. Ships and operates complete products — enterprise integrations, AI agents, mobile apps in production."
    />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="es" href={es} />
    <link rel="alternate" hreflang="x-default" href={en} />
    <script is:inline define:vars={{ en, es }}>
      var target = (navigator.language || 'en').toLowerCase().startsWith('es') ? es : en;
      location.replace(target);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        gap: 1rem;
        background: #0c1017;
        color: #d8dee7;
        font-family: system-ui, sans-serif;
      }
      div {
        display: grid;
        gap: 0.75rem;
        text-align: center;
      }
      a {
        color: #f0a423;
      }
    </style>
  </head>
  <body>
    <div>
      <p>Henry Cabello</p>
      <p><a href={en}>English</a> · <a href={es}>Español</a></p>
    </div>
  </body>
</html>
