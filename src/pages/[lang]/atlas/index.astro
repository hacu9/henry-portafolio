---
/**
 * ATLAS — travel sideways through the work.
 *
 * Uncommon Studio's "transitions as camera moves" and the scroll-sequenced
 * reveal pattern, taken to its conclusion: the page moves horizontally, and
 * each project is a room you arrive at rather than a card in a list.
 *
 * Horizontal scroll is usually a usability disaster, so this uses the sticky
 * translate technique — the reader still scrolls DOWN with a normal wheel,
 * trackpad or spacebar, and the content moves across. Below 900px and under
 * reduced-motion it degrades to an ordinary vertical stack, because a phone
 * has no business doing this.
 */
import Base from '../../../layouts/Base.astro';
import TechWall from '../../../components/TechWall.astro';
import TechRow from '../../../components/TechRow.astro';
import ContactSwitch from '../../../components/ContactSwitch.astro';
import { LANGS, t, tl, OTHER_LANG, LANG_LABEL, path , asset} from '../../../i18n/types';
import type { Lang } from '../../../i18n/types';
import { ui } from '../../../i18n/ui';
import { profile } from '../../../data/profile';
import { leadProjects, supportingProjects, STATUS_LABEL, projectName } from '../../../data/projects';
import { stackGroups } from '../../../data/stack';
import { timeline, presentLabel } from '../../../data/timeline';
import { COARSE_TIMELINE_DATES } from '../../../data/config';
import '../../../styles/reset.css';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const other = OTHER_LANG[lang];
const altHref = path(base, other, 'atlas');
const indexHref = path(base, lang);

/** Rooms in the gallery: the opening, one per lead project, then the close. */
// Opening + two rooms per project + the closing room.
const rooms = leadProjects.length * 2 + 2;
---

<Base
  lang={lang}
  title={`${profile.name} — ${t(profile.title, lang)}`}
  description={t(profile.positioning, lang)}
  slug="atlas"
  themeColor="#0A1018"
  scrollDuration={1.15}
>
  <a class="skip" href="#rest">{t(ui.skipToContent, lang)}</a>

  <header class="bar">
    <a class="mark" href={indexHref}>{profile.name}</a>
    <div class="progress" aria-hidden="true"><span id="pbar"></span></div>
    <div class="tools">
      <a href={altHref} hreflang={other} lang={other}>{LANG_LABEL[other]}</a>
      <button data-theme-toggle type="button">
        <span class="visually-hidden">{t(ui.toggleTheme, lang)}</span>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </header>

  <!-- The gallery. Height drives how far the track travels sideways. -->
  <section class="gallery" style={`--rooms:${rooms}`} aria-label={t(ui.leadWork, lang)}>
    <div class="viewport">
      <div class="track" id="track">
        <article class="room open">
          <p class="kick">{t(profile.title, lang)} — {t(profile.experience, lang)}</p>
          <h1>{profile.name}</h1>
          <p class="lede">{t(profile.positioning, lang)}</p>
          <p class="kick">{t(profile.location, lang)} · {t(profile.workingStyle, lang)}</p>
          <p class="go" aria-hidden="true">
            {lang === 'es' ? 'Desplázate — el trabajo avanza de lado' : 'Scroll — the work moves sideways'}
            <span class="arrow">→</span>
          </p>
        </article>

        {
          /* Two rooms per project. Four beats plus a heading cannot fit one
             screen on a laptop, and a gallery that clips its own content is
             worse than one with more rooms. */
          leadProjects.map((p, i) => (
            <>
              <article class="room proj">
                <div class="room-head">
                  <span class="rn" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')} / {String(leadProjects.length).padStart(2, '0')}
                  </span>
                  <h2>{projectName(p, lang)}</h2>
                  <p class="tag">
                    {t(p.tagline, lang)}
                    {p.url && (
                      <>
                        {' · '}
                        <a class="verify-link" href={p.url} target="_blank" rel="noopener">
                          {p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗
                        </a>
                      </>
                    )}
                    <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
                  </p>
                </div>
                <div class="room-body">
                  <div>
                    <p class="kick">{t(ui.theProblem, lang)}</p>
                    <p>{t(p.problem, lang)}</p>
                  </div>
                  <div>
                    <p class="kick">{t(ui.whatIBuilt, lang)}</p>
                    <ul>{tl(p.built, lang).map((b) => <li>{b}</li>)}</ul>
                  </div>
                </div>
              </article>

              <article class="room proj">
                <div class="room-head">
                  <span class="rn" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')} — {t(ui.theDecision, lang)}
                  </span>
                  <h2 class="room-sub">{projectName(p, lang)}</h2>
                </div>
                <div class="room-body">
                  <div>
                    <p class="kick">
                      {p.decisions.length > 1 ? t(ui.theDecisions, lang) : t(ui.theDecision, lang)}
                    </p>
                    {p.decisions.map((d) => (
                      <div class="call">
                        <h3>{t(d.title, lang)}</h3>
                        <p>{t(d.body, lang)}</p>
                      </div>
                    ))}
                  </div>
                  <div>
                    <p class="kick">{t(ui.theOutcome, lang)}</p>
                    <p class="out">{t(p.outcome, lang)}</p>
                    {p.shots && (
                      <div class="shots">
                        {p.shots.map((sh) => (
                          <img src={asset(base, sh.src)} alt={t(sh.alt, lang)} loading="lazy" decoding="async" />
                        ))}
                      </div>
                    )}
                    <TechRow items={p.stack} size="sm" />
                  </div>
                </div>
              </article>
            </>
          ))
        }

        <article class="room end">
          <p class="kick">{t(ui.howIWork, lang)}</p>
          <h2>{t(profile.thesis.lead, lang)}</h2>
          <div class="end-cols">
            {tl(profile.thesis.body, lang).map((p) => <p>{p}</p>)}
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Everything below is ordinary vertical reading. -->
  <main id="rest">
    <section class="blk">
      <p class="kick" data-rise>{t(ui.supportingWork, lang)}</p>
      <div class="minis" data-stagger>
        {
          supportingProjects.map((p) => (
            <article class="mini spot">
              <h3>
                {projectName(p, lang)}
                <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              </h3>
              <p class="tag plain">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              <p>{t(p.problem, lang)}</p>
              <p class="inline-call">
                <strong>{t(p.decisions[0].title, lang)}.</strong> {t(p.decisions[0].body, lang)}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="blk">
      <p class="kick" data-rise>{t(ui.whatIUse, lang)}</p>
      <TechWall />
      <div class="stacks" data-stagger>
        {
          stackGroups.map((g) => (
            <div class="sg">
              <h3>{t(g.label, lang)}</h3>
              <p class="items">{g.items.join('  ·  ')}</p>
              {g.note && <p class="note">{t(g.note, lang)}</p>}
            </div>
          ))
        }
      </div>
    </section>

    <section class="blk">
      <p class="kick" data-rise>{t(ui.timeline, lang)}</p>
      <ol class="record" data-camera>
        {
          timeline.map((e) => (
            <li>
              <span class="when">
                {COARSE_TIMELINE_DATES
                  ? e.yearsOnly
                  : `${e.from} — ${e.to === 'Present' ? t(presentLabel, lang) : e.to}`}
              </span>
              <span class="what">
                <strong>{t(e.role, lang)}</strong>
                <span>{e.org}</span>
                {e.detail && <span class="det">{t(e.detail, lang)}</span>}{e.highlights && (<ul class="role-hl">{tl(e.highlights, lang).map((h) => <li>{h}</li>)}</ul>)}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="contact" class="blk close spot" data-camera>
      <div class="contact-id"><img class="portrait" src={asset(base, profile.photo)} alt={t(profile.photoAlt, lang)} width="72" height="72" loading="lazy" />
        <p class="kick">{t(ui.getInTouch, lang)}</p></div>
      {t(ui.contactLede, lang) && <h2 class="big">{t(ui.contactLede, lang)}</h2>}
      <ContactSwitch lang={lang} />
    </section>
  </main>

  <footer class="foot">
    <span>{profile.name} · {t(profile.location, lang)}</span>
    <a href={indexHref}>{t(ui.backToIndex, lang)}</a>
  </footer>
</Base>

<style>
  :root {
    --ground: #eef1f5;
    --raise: #ffffff;
    --ink: #0a1018;
    --ink-2: #3c4a5a;
    --dim: #6f7f92;
    --line: #ccd5e0;
    --accent: #1e5fa8;
    --focus: #1e5fa8;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    --shell: 74rem;
    --read: 34rem;
    --pad: clamp(1.15rem, 4vw, 3rem);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #0a1018;
      --raise: #101a26;
      --ink: #e2e9f2;
      --ink-2: #a6b6c8;
      --dim: #6f7f92;
      --line: #1d2937;
      --accent: #6fb3f2;
    }
  }
  :global(:root[data-theme='dark']) {
    --ground: #0a1018;
    --raise: #101a26;
    --ink: #e2e9f2;
    --ink-2: #a6b6c8;
    --dim: #6f7f92;
    --line: #1d2937;
    --accent: #6fb3f2;
  }
  :global(:root[data-theme='light']) {
    --ground: #eef1f5;
    --raise: #ffffff;
    --ink: #0a1018;
    --ink-2: #3c4a5a;
    --dim: #6f7f92;
    --line: #ccd5e0;
    --accent: #1e5fa8;
  }

  :global(body) {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.62;
  }

  .kick {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.6rem var(--pad);
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .bar a { text-decoration: none; }
  .mark { font-weight: 700; }
  .progress { flex: 1; height: 2px; background: var(--line); max-width: 22rem; }
  #pbar { display: block; height: 100%; width: 0%; background: var(--accent); }
  .tools { margin-inline-start: auto; display: flex; gap: 0.8rem; align-items: center; color: var(--dim); }
  .tools a:hover, .tools button:hover { color: var(--accent); }

  /* ------------------------------------------------------------- gallery */
  .gallery { height: calc(var(--rooms) * 90svh); position: relative; }
  .viewport { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .track {
    display: flex;
    height: 100%;
    align-items: center;
    will-change: transform;
    /* Half a viewport of lead-in and lead-out, so the first and last rooms
       sit centred rather than jammed against the edge. */
    padding-inline: max(0px, calc((100vw - min(72rem, 92vw)) / 2));
  }
  .room {
    flex: 0 0 min(72rem, 92vw);
    height: 100%;
    padding: 4.5rem clamp(1.5rem, 3vw, 3rem) 2rem;
    display: grid;
    align-content: center;
    gap: 1rem;
    border-right: 1px solid var(--line);
  }
  .open h1 {
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    line-height: 0.94;
    letter-spacing: -0.04em;
    font-weight: 700;
    margin: 0;
  }
  .lede {
    font-size: clamp(1rem, 1.7vw, 1.28rem);
    color: var(--ink-2);
    max-width: 34ch;
    line-height: 1.44;
    text-wrap: pretty;
  }
  .go { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); display: flex; gap: 0.6rem; align-items: center; }
  .arrow { animation: nudge 1.9s ease-in-out infinite; }
  @keyframes nudge { 0%,100% { transform: translateX(0); } 50% { transform: translateX(0.4rem); } }
  @media (prefers-reduced-motion: reduce) { .arrow { animation: none; } }

  .room-head { display: grid; gap: 0.4rem; border-bottom: 1px solid var(--line); padding-bottom: 0.9rem; }
  .rn { font-family: var(--mono); font-size: 0.6875rem; color: var(--accent); font-variant-numeric: tabular-nums; letter-spacing: 0.1em; }
  .room h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.032em;
    font-weight: 700;
    margin: 0;
  }
  .tag { font-family: var(--mono); font-size: 0.6875rem; color: var(--dim); display: flex; gap: 0.7rem; align-items: center; flex-wrap: wrap; }
  .st {
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    padding: 0.06rem 0.35rem;
  }
  .st-live { color: #2f9e6b; }
  .st-building { color: var(--accent); }
  .st-ongoing, .st-delivered { color: var(--dim); }
  @media (prefers-color-scheme: dark) { .st-live { color: #57d39b; } }

  .room-body {
    display: grid;
    gap: 0.9rem 2rem;
    padding-top: 0.8rem;
    /* No overflow-y here on purpose. */
    min-height: 0;
  }
  @media (min-width: 800px) { .room-body { grid-template-columns: 1fr 1fr; } }
  .room-body > div { display: grid; gap: 0.4rem; align-content: start; }
  .room-body p, .room-body ul { color: var(--ink-2); font-size: 0.85rem; line-height: 1.5; max-width: var(--read); }
  .room-body ul { display: grid; gap: 0.22rem; list-style: none; padding: 0; }
  .room-body li::before { content: '— '; color: var(--accent); }
  .call { display: grid; gap: 0.25rem; }
  .call + .call { margin-top: 0.6rem; }
  .call h3 { font-size: 0.95rem; font-weight: 650; color: var(--ink); margin: 0; line-height: 1.3; }
  .out { color: var(--ink) !important; }
  .deps { font-family: var(--mono); font-size: 0.625rem; color: var(--dim) !important; border-top: 1px solid var(--line); padding-top: 0.5rem; margin-top: 0.4rem; }

  .end h2 { font-size: clamp(1.7rem, 4vw, 2.8rem); }
  .room-sub { opacity: 0.42; font-size: clamp(1.3rem, 2.6vw, 1.9rem) !important; }
  .room .shots { margin-top: 0.5rem; }
  .room .shots img { width: clamp(96px, 12vw, 128px); border-radius: 10px; }
  .end-cols { display: grid; gap: 0.8rem; color: var(--ink-2); font-size: 0.92rem; }
  .counter { border-top: 1px solid var(--line); padding-top: 0.8rem; color: var(--dim); font-size: 0.875rem; max-width: 40rem; }

  /* Below 900px, or with reduced motion, the gallery becomes a normal stack. */
  @media (max-width: 899px), (max-height: 640px), (prefers-reduced-motion: reduce) {
    .gallery { height: auto; }
    .viewport { position: static; height: auto; overflow: visible; }
    .track { display: grid; transform: none !important; }
    .room {
      flex: none;
      height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 3rem var(--pad);
    }
    .room-body { overflow: visible; }
    .go { display: none; }
  }

  /* --------------------------------------------------------------- rest */
  .blk {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--pad);
    border-top: 1px solid var(--line);
    display: grid;
    gap: 1.3rem;
  }
  .minis { display: grid; gap: 1rem; }
  @media (min-width: 820px) { .minis { grid-template-columns: 1fr 1fr; } }
  .mini {
    --spot-color: var(--accent);
    background: var(--raise);
    border: 1px solid var(--line);
    padding: 1.1rem 1.2rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .mini h3 { font-size: 1.05rem; display: flex; gap: 0.7rem; align-items: center; flex-wrap: wrap; margin: 0; }
  .mini p { color: var(--ink-2); font-size: 0.9rem; }
  .inline-call strong { color: var(--ink); }

  .stacks { display: grid; gap: 1rem; }
  @media (min-width: 800px) { .stacks { grid-template-columns: 1fr 1fr; } }
  .sg { display: grid; gap: 0.4rem; border-top: 1px solid var(--line); padding-top: 0.8rem; }
  .sg h3 { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); font-weight: 500; margin: 0; }
  .items { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-2); line-height: 1.85; }
  .note { color: var(--dim); font-size: 0.875rem; max-width: var(--read); }

  .record { display: grid; list-style: none; padding: 0; margin: 0; }
  .record li { display: grid; gap: 0.1rem 2rem; padding: 0.8rem 0; border-top: 1px solid var(--line); }
  @media (min-width: 660px) { .record li { grid-template-columns: 11rem 1fr; } }
  .when { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); font-variant-numeric: tabular-nums; padding-top: 0.3rem; }
  .what { display: grid; gap: 0.05rem; }
  .what span { color: var(--ink-2); font-size: 0.9rem; }
  .what .det { color: var(--dim); font-size: 0.85rem; }

  .close { --spot-color: var(--accent); }
  .big { font-size: clamp(1.7rem, 4.2vw, 2.9rem); letter-spacing: -0.03em; max-width: 22ch; margin: 0; text-wrap: balance; }
  .links { display: flex; flex-wrap: wrap; gap: 1.5rem; font-family: var(--mono); font-size: 0.875rem; }
  .links a { color: var(--accent); text-underline-offset: 4px; }

  .foot {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.4rem var(--pad) 3rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .foot a { color: var(--accent); }

  .verify-link {
    color: var(--accent, currentColor);
    text-underline-offset: 3px;
    font-weight: 600;
    white-space: nowrap;
  }
  .verify-link:hover { filter: brightness(1.15); }

  .role-hl {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }
  .role-hl li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.875rem;
    color: var(--ink-2, currentColor);
    line-height: 1.5;
  }
  .role-hl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--accent, currentColor);
  }

  .contact-id { display: flex; align-items: center; gap: 0.9rem; }

  /* Portrait beside the contact heading — a face where someone decides to write. */
  .portrait {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent, currentColor);
    flex: none;
  }
  /* Product screenshots. Phone-shaped, so they scroll rather than squash. */
  .shots {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
    margin-block: 0.3rem;
    scroll-snap-type: x mandatory;
  }
  .shots img {
    width: clamp(140px, 26vw, 210px);
    height: auto;
    flex: none;
    border-radius: 12px;
    scroll-snap-align: start;
    background: var(--raise, transparent);
  }
</style>

<script>
  // Vertical scroll drives the track sideways.
  //
  // This runs in a continuous rAF loop while the gallery is on screen, NOT on
  // the scroll event. Lenis interpolates the scroll position every frame, so a
  // scroll-event listener applies the transform one frame late and the track
  // visibly swims behind the wheel. Reading the rect each frame keeps the
  // horizontal motion locked to whatever Lenis has actually set.
  const gallery = document.querySelector<HTMLElement>('.gallery');
  const track = document.getElementById('track');
  const pbar = document.getElementById('pbar');

  // Must mirror the media query in the stylesheet exactly, or the script
  // translates a track that CSS has already laid out vertically.
  const wide = window.matchMedia('(min-width: 900px) and (min-height: 641px)');
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (gallery && track) {
    let inView = true;
    new IntersectionObserver(
      (entries) => entries.forEach((e) => (inView = e.isIntersecting)),
      { rootMargin: '100px' },
    ).observe(gallery);

    let lastX = -1;

    const frame = () => {
      const horizontal = wide.matches && motionOk.matches;

      if (horizontal && inView) {
        const rect = gallery.getBoundingClientRect();
        const span = gallery.offsetHeight - window.innerHeight;
        const progress = span > 0 ? Math.min(1, Math.max(0, -rect.top / span)) : 0;
        const distance = Math.max(0, track.scrollWidth - window.innerWidth);
        const x = -progress * distance;

        // Only touch the DOM when the value actually changes.
        if (Math.abs(x - lastX) > 0.05) {
          track.style.transform = `translate3d(${x}px,0,0)`;
          lastX = x;
        }
        if (pbar) pbar.style.width = `${progress * 100}%`;
      } else if (!horizontal && lastX !== 0) {
        track.style.transform = '';
        lastX = 0;
      }

      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    // Below the gallery, or in the stacked layout, the bar tracks page scroll.
    const pageProgress = () => {
      if (wide.matches && motionOk.matches && inView) return;
      const doc = document.documentElement;
      const p = doc.scrollTop / Math.max(1, doc.scrollHeight - doc.clientHeight);
      if (pbar) pbar.style.width = `${p * 100}%`;
    };
    window.addEventListener('scroll', pageProgress, { passive: true });

    // A resize changes both the travel distance and the layout mode.
    window.addEventListener('resize', () => {
      lastX = -1;
    });
    wide.addEventListener('change', () => {
      lastX = -1;
      track.style.transform = '';
    });
  }
</script>
