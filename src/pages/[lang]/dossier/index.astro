---
/**
 * DOSSIER — what I can and cannot show you.
 *
 * This direction turns Henry's biggest portfolio problem into the concept.
 * His strongest work is behind a client login or an NDA, so the site is built
 * as a case file: some material is open, some is redacted, and the redaction
 * is honest rather than teasing. Hovering a bar does not reveal a secret — it
 * reveals WHY the thing is withheld.
 *
 * The redaction only ever covers content that genuinely is restricted. Nothing
 * available is hidden for effect, because a portfolio that plays hard to get
 * with its own evidence is just friction.
 */
import Base from '../../../layouts/Base.astro';
import { LANGS, t, tl, OTHER_LANG, LANG_LABEL, path } from '../../../i18n/types';
import type { Lang } from '../../../i18n/types';
import { ui } from '../../../i18n/ui';
import { profile } from '../../../data/profile';
import { leadProjects, supportingProjects, STATUS_LABEL, projectName } from '../../../data/projects';
import { stackGroups } from '../../../data/stack';
import { timeline, presentLabel } from '../../../data/timeline';
import { COARSE_TIMELINE_DATES } from '../../../data/config';
import '../../../styles/reset.css';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const other = OTHER_LANG[lang];
const altHref = path(base, other, 'dossier');
const indexHref = path(base, lang);

const L = {
  file: { en: 'FILE', es: 'EXPEDIENTE' },
  subject: { en: 'SUBJECT', es: 'SUJETO' },
  clearance: { en: 'DISCLOSURE', es: 'DIVULGACIÓN' },
  open: { en: 'OPEN', es: 'ABIERTO' },
  restricted: { en: 'RESTRICTED', es: 'RESERVADO' },
  why: {
    en: 'Client name withheld pending permission. The work is described in full; only the name is restricted.',
    es: 'Nombre del cliente reservado a la espera de permiso. El trabajo está descrito completo; solo el nombre está restringido.',
  },
  note: {
    en: 'Most of my strongest work runs behind a client login. Rather than pretend otherwise, this file shows the engineering in full and withholds only what is not mine to publish.',
    es: 'Gran parte de mi mejor trabajo vive detrás del login de un cliente. En vez de disimularlo, este expediente muestra la ingeniería completa y reserva solo lo que no me corresponde publicar.',
  },
};
---

<Base
  lang={lang}
  title={`${profile.name} — ${t(profile.title, lang)}`}
  description={t(profile.positioning, lang)}
  slug="dossier"
  themeColor="#12100C"
>
  <a class="skip" href="#main">{t(ui.skipToContent, lang)}</a>

  <header class="bar">
    <a class="mark" href={indexHref}>{L.file[lang]} / HC-01</a>
    <span class="stamp">{L.open[lang]}</span>
    <div class="tools">
      <a href={altHref} hreflang={other} lang={other}>{LANG_LABEL[other]}</a>
      <button data-theme-toggle type="button">
        <span class="visually-hidden">{t(ui.toggleTheme, lang)}</span>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </header>

  <main id="main">
    <section class="cover">
      <div class="cover-head">
        <p class="k">{L.subject[lang]}</p>
        <h1>{profile.name}</h1>
        <p class="role">{t(profile.title, lang)} · {t(profile.experience, lang)}</p>
      </div>
      <div class="cover-grid">
        <p class="lede">{t(profile.positioning, lang)}</p>
        <dl class="idcard">
          <div><dt>{t(ui.basedIn, lang)}</dt><dd>{t(profile.location, lang)}</dd></div>
          <div><dt>{t(ui.stack, lang)}</dt><dd>TS · Next · RN · PostgreSQL</dd></div>
          <div><dt>{L.clearance[lang]}</dt><dd class="ok">{L.open[lang]}</dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
        </dl>
      </div>
      <p class="disclosure">{L.note[lang]}</p>
    </section>

    <section id="approach" class="folder">
      <div class="tab"><span class="k">{t(ui.howIWork, lang)}</span></div>
      <div class="sheet" data-camera>
        <h2>{t(profile.thesis.lead, lang)}</h2>
        <div class="cols" data-stagger>
          {tl(profile.thesis.body, lang).map((p) => <p>{p}</p>)}
        </div>
        <p class="caveat">
          <span class="k">{t(ui.theTradeoff, lang)}</span>
          {t(profile.thesis.tradeoff, lang)}
        </p>
      </div>
    </section>

    <section id="work">
      {
        leadProjects.map((p, i) => (
          <article class="folder case" data-camera>
            <div class="tab">
              <span class="k">{L.file[lang]} {String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="sheet">
              <div class="case-head">
                <h2>{projectName(p, lang)}</h2>
                <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              </div>
              <p class="tag">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>

              <div class="rows" data-stagger>
                <div class="row">
                  <span class="k">{t(ui.theProblem, lang)}</span>
                  <p>{t(p.problem, lang)}</p>
                </div>
                <div class="row">
                  <span class="k">{t(ui.whatIBuilt, lang)}</span>
                  <ul>{tl(p.built, lang).map((b) => <li>{b}</li>)}</ul>
                </div>
                <div class="row">
                  <span class="k">
                    {p.decisions.length > 1 ? t(ui.theDecisions, lang) : t(ui.theDecision, lang)}
                  </span>
                  <div>
                    {p.decisions.map((d) => (
                      <div class="call">
                        <h3>{t(d.title, lang)}</h3>
                        <p>{t(d.body, lang)}</p>
                      </div>
                    ))}
                  </div>
                </div>
                <div class="row">
                  <span class="k">{t(ui.theOutcome, lang)}</span>
                  <p class="out">{t(p.outcome, lang)}</p>
                </div>
              </div>
              <p class="deps">{p.stack.join('  ·  ')}</p>
            </div>
          </article>
        ))
      }
    </section>

    <section class="folder">
      <div class="tab"><span class="k">{t(ui.supportingWork, lang)}</span></div>
      <div class="sheet">
        <div class="minis" data-stagger>
          {
            supportingProjects.map((p) => (
              <article class="mini">
                <h3>
                  {/* Only genuinely restricted names get the bar. */}
                  {p.confidential ? (
                    <button class="redact" type="button" aria-describedby={`why-${p.id}`}>
                      <span class="bar-fill" aria-hidden="true" />
                      <span class="redact-text">{projectName(p, lang)}</span>
                    </button>
                  ) : (
                    projectName(p, lang)
                  )}
                  <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
                </h3>
                {p.confidential && (
                  <p class="why" id={`why-${p.id}`}>
                    {L.why[lang]}
                  </p>
                )}
                <p class="tag">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
                <p>{t(p.problem, lang)}</p>
                <p class="inline-call">
                  <strong>{t(p.decisions[0].title, lang)}.</strong> {t(p.decisions[0].body, lang)}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="folder">
      <div class="tab"><span class="k">{t(ui.whatIUse, lang)}</span></div>
      <div class="sheet">
        {
          stackGroups.map((g) => (
            <div class="sg">
              <h3>{t(g.label, lang)}</h3>
              <p class="items">{g.items.join('  ·  ')}</p>
              {g.note && <p class="note">{t(g.note, lang)}</p>}
            </div>
          ))
        }
      </div>
    </section>

    <section class="folder">
      <div class="tab"><span class="k">{t(ui.timeline, lang)}</span></div>
      <div class="sheet">
        <ol class="record">
          {
            timeline.map((e) => (
              <li>
                <span class="when">
                  {COARSE_TIMELINE_DATES
                    ? e.yearsOnly
                    : `${e.from} — ${e.to === 'Present' ? t(presentLabel, lang) : e.to}`}
                </span>
                <span class="what">
                  <strong>{t(e.role, lang)}</strong>
                  <span>{e.org}</span>
                  {e.detail && <span class="det">{t(e.detail, lang)}</span>}{e.highlights && (<ul class="role-hl">{tl(e.highlights, lang).map((h) => <li>{h}</li>)}</ul>)}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="contact" class="closing">
      <p class="k">{t(ui.getInTouch, lang)}</p>
      <h2>{t(ui.contactLede, lang)}</h2>
      <p class="links">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.linkedinUrl} rel="me noopener">LinkedIn</a>
        <a href={profile.githubUrl} rel="me noopener">GitHub</a>
      </p>
    </section>
  </main>

  <footer class="foot">
    <span>{L.file[lang]} HC-01 · {profile.name}</span>
    <a href={indexHref}>{t(ui.backToIndex, lang)}</a>
  </footer>
</Base>

<style>
  :root {
    --ground: #ece6d9;
    --raise: #f6f2e8;
    --ink: #1d1a13;
    --ink-2: #4a4438;
    --dim: #7d7666;
    --line: #cbc2ad;
    --accent: #8a5a12;
    --focus: #8a5a12;
    --redact: #1d1a13;
    --grain-opacity: 0.07;
    --serif: 'Iowan Old Style', 'Charter', 'Palatino Linotype', Georgia, serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    --shell: 68rem;
    --read: 36rem;
    --pad: clamp(1.15rem, 4vw, 3rem);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #12100c;
      --raise: #191610;
      --ink: #e8e1d1;
      --ink-2: #b0a790;
      --dim: #7d7666;
      --line: #2a2519;
      --accent: #d9a441;
      --redact: #e8e1d1;
    }
  }
  :global(:root[data-theme='dark']) {
    --ground: #12100c;
    --raise: #191610;
    --ink: #e8e1d1;
    --ink-2: #b0a790;
    --dim: #7d7666;
    --line: #2a2519;
    --accent: #d9a441;
    --redact: #e8e1d1;
  }
  :global(:root[data-theme='light']) {
    --ground: #ece6d9;
    --raise: #f6f2e8;
    --ink: #1d1a13;
    --ink-2: #4a4438;
    --dim: #7d7666;
    --line: #cbc2ad;
    --accent: #8a5a12;
    --redact: #1d1a13;
  }

  :global(body) {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.62;
  }

  .k {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem var(--pad);
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .bar a { text-decoration: none; }
  .mark { font-weight: 700; }
  .stamp {
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 0.05rem 0.4rem;
    transform: rotate(-1.5deg);
  }
  .tools { margin-inline-start: auto; display: flex; gap: 0.8rem; align-items: center; color: var(--dim); }
  .tools a:hover, .tools button:hover { color: var(--accent); }

  .cover {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(2.5rem, 7vw, 4.5rem) var(--pad);
    display: grid;
    gap: 1.6rem;
  }
  .cover-head { display: grid; gap: 0.4rem; }
  .cover h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .role { font-family: var(--mono); font-size: 0.75rem; color: var(--dim); letter-spacing: 0.06em; }
  .cover-grid { display: grid; gap: 1.6rem; padding-top: 1rem; border-top: 2px solid var(--ink); }
  @media (min-width: 880px) { .cover-grid { grid-template-columns: 1.4fr 1fr; gap: 3rem; } }
  .lede {
    font-size: clamp(1.02rem, 1.8vw, 1.28rem);
    color: var(--ink-2);
    max-width: 34ch;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .idcard { display: grid; align-content: start; margin: 0; font-family: var(--mono); font-size: 0.75rem; }
  .idcard div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.35rem 0; border-bottom: 1px dashed var(--line); }
  .idcard dt { color: var(--dim); font-size: 0.625rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .idcard dd { margin: 0; }
  .idcard .ok { color: var(--accent); font-weight: 700; }
  .idcard a { color: var(--accent); }
  .disclosure {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    color: var(--ink-2);
    max-width: 46rem;
    font-size: 0.9375rem;
  }

  /* Folder + tab: the filing metaphor, done with two rules rather than art. */
  .folder {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--pad);
    margin-block: clamp(1.5rem, 4vw, 2.5rem);
  }
  .tab {
    display: inline-block;
    background: var(--raise);
    border: 1px solid var(--line);
    border-bottom: 0;
    padding: 0.3rem 0.9rem;
  }
  .sheet {
    background: var(--raise);
    border: 1px solid var(--line);
    padding: clamp(1.2rem, 3vw, 2rem);
    display: grid;
    gap: 1.1rem;
  }
  .sheet h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }
  .cols { display: grid; gap: 1rem; color: var(--ink-2); }
  @media (min-width: 860px) { .cols { grid-template-columns: repeat(3, 1fr); gap: 1.8rem; } }
  .caveat {
    border-top: 1px dashed var(--line);
    padding-top: 0.9rem;
    color: var(--dim);
    max-width: 46rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.9375rem;
  }

  .case-head { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .st {
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    padding: 0.08rem 0.38rem;
    white-space: nowrap;
  }
  .st-live { color: #2c6e4a; }
  .st-building { color: var(--accent); }
  .st-ongoing, .st-delivered { color: var(--dim); }
  @media (prefers-color-scheme: dark) { .st-live { color: #5fbf8b; } }
  .tag { font-family: var(--mono); font-size: 0.6875rem; color: var(--dim); margin-top: -0.5rem; }

  .rows { display: grid; gap: 0.9rem; }
  .row { display: grid; gap: 0.35rem; padding-block: 0.6rem; border-top: 1px dashed var(--line); }
  @media (min-width: 820px) { .row { grid-template-columns: 10rem 1fr; gap: 0 1.8rem; } }
  .row p, .row ul { color: var(--ink-2); max-width: var(--read); }
  .row ul { display: grid; gap: 0.25rem; list-style: none; padding: 0; }
  .row li::before { content: '☐ '; color: var(--accent); }
  .call { display: grid; gap: 0.3rem; }
  .call + .call { margin-top: 0.7rem; }
  .call h3 { font-size: 1rem; font-weight: 650; margin: 0; line-height: 1.3; color: var(--ink); }
  .out { color: var(--ink) !important; }
  .deps {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--dim);
    border-top: 1px solid var(--line);
    padding-top: 0.7rem;
  }

  .minis { display: grid; gap: 1.4rem; }
  @media (min-width: 820px) { .minis { grid-template-columns: 1fr 1fr; } }
  .mini { display: grid; gap: 0.45rem; align-content: start; }
  .mini h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.35rem;
    display: flex;
    gap: 0.7rem;
    align-items: center;
    flex-wrap: wrap;
    margin: 0;
  }
  .mini p { color: var(--ink-2); font-size: 0.9375rem; }
  .inline-call strong { color: var(--ink); }

  /* The redaction. Reveals the reason, never a secret. */
  .redact {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: help;
  }
  .bar-fill {
    position: absolute;
    inset: 0.12em -0.25em;
    background: var(--redact);
    transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.2, 1);
    transform-origin: left center;
  }
  .redact-text { visibility: hidden; }
  .redact:hover .bar-fill,
  .redact:focus-visible .bar-fill {
    transform: scaleX(0);
  }
  .redact:hover .redact-text,
  .redact:focus-visible .redact-text {
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .bar-fill { transition: none; }
  }
  .why {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--accent);
    border-left: 2px solid var(--accent);
    padding-left: 0.6rem;
    max-width: 34rem;
  }

  .sg { display: grid; gap: 0.4rem; border-top: 1px dashed var(--line); padding-top: 0.8rem; }
  .sg h3 {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin: 0;
  }
  .items { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-2); line-height: 1.85; }
  .note { color: var(--dim); font-size: 0.875rem; max-width: var(--read); }

  .record { display: grid; list-style: none; padding: 0; margin: 0; }
  .record li { display: grid; gap: 0.1rem 2rem; padding: 0.7rem 0; border-top: 1px dashed var(--line); }
  @media (min-width: 660px) { .record li { grid-template-columns: 11rem 1fr; } }
  .when { font-family: var(--mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); font-variant-numeric: tabular-nums; padding-top: 0.25rem; }
  .what { display: grid; gap: 0.05rem; }
  .what span { color: var(--ink-2); font-size: 0.9375rem; }
  .what .det { color: var(--dim); font-size: 0.875rem; }

  .closing {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(3rem, 8vw, 5rem) var(--pad);
    border-top: 2px solid var(--ink);
    display: grid;
    gap: 1rem;
  }
  .closing h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 3.6vw, 2.5rem);
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin: 0;
  }
  .links { display: flex; flex-wrap: wrap; gap: 1.5rem; font-family: var(--mono); font-size: 0.875rem; }
  .links a { color: var(--accent); text-underline-offset: 4px; }

  .foot {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.3rem var(--pad) 3rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .foot a { color: var(--accent); }

  .verify-link {
    color: var(--accent, currentColor);
    text-underline-offset: 3px;
    font-weight: 600;
    white-space: nowrap;
  }
  .verify-link:hover { filter: brightness(1.15); }

  .role-hl {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }
  .role-hl li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.875rem;
    color: var(--ink-2, currentColor);
    line-height: 1.5;
  }
  .role-hl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--accent, currentColor);
  }
</style>
