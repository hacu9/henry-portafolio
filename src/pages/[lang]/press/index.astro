---
/**
 * PRESS — Swiss grid, printed loud.
 *
 * Uncommon Studio's "grid-breaking rhythm" needs a grid to break, so this one
 * is explicit: a visible 12-column rule, oversized numerals, hard black rules,
 * one red. Nothing decorative — the impact comes from scale contrast and from
 * type sitting exactly on the grid until it deliberately does not.
 */
import Base from '../../../layouts/Base.astro';
import TechWall from '../../../components/TechWall.astro';
import TechRow from '../../../components/TechRow.astro';
import ContactSwitch from '../../../components/ContactSwitch.astro';
import { LANGS, t, tl, OTHER_LANG, LANG_LABEL, path , asset} from '../../../i18n/types';
import type { Lang } from '../../../i18n/types';
import { ui } from '../../../i18n/ui';
import { profile } from '../../../data/profile';
import { leadProjects, supportingProjects, STATUS_LABEL, projectName } from '../../../data/projects';
import { stackGroups } from '../../../data/stack';
import { timeline, presentLabel } from '../../../data/timeline';
import { COARSE_TIMELINE_DATES } from '../../../data/config';
import '../../../styles/reset.css';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const other = OTHER_LANG[lang];
const altHref = path(base, other, 'press');
const indexHref = path(base, lang);
---

<Base
  lang={lang}
  title={`${profile.name} — ${t(profile.title, lang)}`}
  description={t(profile.summary, lang)}
  slug="press"
  themeColor="#F2F0EC"
  grain={false}
>
  <a class="skip" href="#main">{t(ui.skipToContent, lang)}</a>

  <header class="bar">
    <a class="mark" href={indexHref}>{profile.name}</a>
    <span class="meta">{t(profile.title, lang)}</span>
    <span class="meta">{t(profile.location, lang)}</span>
    <div class="tools">
      <a href={altHref} hreflang={other} lang={other}>{LANG_LABEL[other]}</a>
      <button data-theme-toggle type="button">
        <span class="visually-hidden">{t(ui.toggleTheme, lang)}</span>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </header>

  <main id="main">
    <!-- The masthead breaks the grid on purpose: the name runs full bleed. -->
    <section class="masthead">
      <h1 aria-label={profile.name}>
        <span>HENRY</span><span class="out">CABELLO</span>
      </h1>
      <div class="mast-rule"></div>
      <div class="mast-grid">
        <div><p class="mast-claim">{t(profile.positioning, lang)}</p>
        <p class="lede">{t(profile.lede, lang)}</p></div>
        <dl class="facts">
          <div><dt>{t(ui.yearsShipping, lang)}</dt><dd><span data-count="8" data-suffix="+">0</span></dd></div>
          <div><dt>{lang === 'es' ? 'En producción' : 'In production'}</dt><dd><span data-count="1">0</span></dd></div>
          <div><dt>{t(ui.contact, lang)}</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
        </dl>
      </div>
    </section>

    <section id="approach" class="sheet">
      <div class="sheet-label"><span class="kick">{t(ui.howIWork, lang)}</span></div>
      <div class="sheet-body" data-camera>
        <h2 class="loud">{t(profile.thesis.lead, lang)}</h2>
        <div class="cols" data-stagger>
          {tl(profile.thesis.body, lang).map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section id="work">
      {
        leadProjects.map((p, i) => (
          <article class="entry" data-camera>
            <div class="entry-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <div class="entry-body">
              <div class="entry-head">
                <h2>{projectName(p, lang)}</h2>
                <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              </div>
              <p class="tag">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              {p.shots && (
                <div class="shots">
                  {p.shots.map((sh) => (
                    <img src={asset(base, sh.src)} alt={t(sh.alt, lang)} loading="lazy" decoding="async" />
                  ))}
                </div>
              )}

              <div class="beats" data-stagger>
                <div>
                  <p class="kick">{t(ui.theProblem, lang)}</p>
                  <p>{t(p.problem, lang)}</p>
                </div>
                <div>
                  <p class="kick">{t(ui.whatIBuilt, lang)}</p>
                  <ul>{tl(p.built, lang).map((b) => <li>{b}</li>)}</ul>
                </div>
                <div class="wide">
                  <p class="kick">
                    {p.decisions.length > 1 ? t(ui.theDecisions, lang) : t(ui.theDecision, lang)}
                  </p>
                  <div class="calls">
                    {p.decisions.map((d) => (
                      <div class="call">
                        <h3>{t(d.title, lang)}</h3>
                        <p>{t(d.body, lang)}</p>
                      </div>
                    ))}
                  </div>
                </div>
                <div class="wide">
                  <p class="kick">{t(ui.theOutcome, lang)}</p>
                  <p class="out-text">{t(p.outcome, lang)}</p>
                </div>
              </div>
              <TechRow items={p.stack} size="sm" />
            </div>
          </article>
        ))
      }
    </section>

    <section class="sheet">
      <div class="sheet-label"><span class="kick">{t(ui.supportingWork, lang)}</span></div>
      <div class="sheet-body">
        <div class="minis" data-stagger>
          {
            supportingProjects.map((p) => (
              <article class="mini">
                <h3>{projectName(p, lang)}</h3>
                <p class="tag">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
                <p>{t(p.problem, lang)}</p>
                <p class="inline-call">
                  <strong>{t(p.decisions[0].title, lang)}.</strong> {t(p.decisions[0].body, lang)}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sheet">
      <div class="sheet-label"><span class="kick">{t(ui.whatIUse, lang)}</span>
      <TechWall /></div>
      <div class="sheet-body">
        {
          stackGroups.map((g) => (
            <div class="sg">
              <h3>{t(g.label, lang)}</h3>
              <p class="items">{g.items.join('  /  ')}</p>
              {g.note && <p class="note">{t(g.note, lang)}</p>}
            </div>
          ))
        }
      </div>
    </section>

    <section class="sheet">
      <div class="sheet-label"><span class="kick">{t(ui.timeline, lang)}</span></div>
      <div class="sheet-body">
        <ol class="record">
          {
            timeline.map((e) => (
              <li>
                <span class="when">
                  {COARSE_TIMELINE_DATES
                    ? e.yearsOnly
                    : `${e.from} — ${e.to === 'Present' ? t(presentLabel, lang) : e.to}`}
                </span>
                <span class="what">
                  <strong>{t(e.role, lang)}</strong>
                  <span>{e.org}</span>
                  {e.detail && <span class="det">{t(e.detail, lang)}</span>}{e.highlights && (<ul class="role-hl">{tl(e.highlights, lang).map((h) => <li>{h}</li>)}</ul>)}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="contact" class="colophon">
      <div class="contact-id"><img class="portrait" src={asset(base, profile.photo)} alt={t(profile.photoAlt, lang)} width="72" height="72" loading="lazy" /></div>
      {t(ui.contactLede, lang) && <h2 class="loud">{t(ui.contactLede, lang)}</h2>}
      <ContactSwitch lang={lang} />
    </section>
  </main>

  <footer class="foot">
    <span>{profile.name}</span>
    <a href={indexHref}>{t(ui.backToIndex, lang)}</a>
  </footer>
</Base>

<style>
  :root {
    --ground: #f2f0ec;
    --raise: #ffffff;
    --ink: #0d0d0d;
    --ink-2: #3d3d3d;
    --dim: #767676;
    --line: #0d0d0d;
    --hair: #cfcbc4;
    --accent: #c22118;
    --focus: #c22118;
    --sans: 'Helvetica Neue', Helvetica, Arial, system-ui, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    --shell: 78rem;
    --read: 34rem;
    --pad: clamp(1rem, 3vw, 2.5rem);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #0d0d0d;
      --raise: #151515;
      --ink: #f2f0ec;
      --ink-2: #c2beb8;
      --dim: #8a8a8a;
      --line: #f2f0ec;
      --hair: #2e2e2e;
      --accent: #ff6152;
    }
  }
  :global(:root[data-theme='dark']) {
    --ground: #0d0d0d;
    --raise: #151515;
    --ink: #f2f0ec;
    --ink-2: #c2beb8;
    --dim: #8a8a8a;
    --line: #f2f0ec;
    --hair: #2e2e2e;
    --accent: #ff6152;
  }
  :global(:root[data-theme='light']) {
    --ground: #f2f0ec;
    --raise: #ffffff;
    --ink: #0d0d0d;
    --ink-2: #3d3d3d;
    --dim: #767676;
    --line: #0d0d0d;
    --hair: #cfcbc4;
    --accent: #c22118;
  }

  :global(body) {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.5;
    letter-spacing: -0.005em;
  }

  .kick {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.5rem var(--pad);
    border-bottom: 2px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--ground);
  }
  .bar a { text-decoration: none; }
  .mark { font-weight: 700; }
  .bar .meta { color: var(--dim); }
  @media (max-width: 760px) { .bar .meta { display: none; } }
  .tools { margin-inline-start: auto; display: flex; gap: 0.8rem; align-items: center; color: var(--dim); }
  .tools a:hover, .tools button:hover { color: var(--accent); }

  /* ------------------------------------------------------------ masthead */
  .masthead {
    padding: clamp(1.5rem, 4vw, 3rem) var(--pad) 0;
    max-width: var(--shell);
    margin-inline: auto;
  }
  .masthead h1 {
    margin: 0;
    display: grid;
    font-weight: 800;
    /* Deliberately oversized: the name is the masthead, not a label. */
    font-size: clamp(3.2rem, 15.5vw, 13rem);
    line-height: 0.82;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }
  .masthead h1 .out {
    color: transparent;
    -webkit-text-stroke: clamp(1px, 0.22vw, 3px) var(--ink);
    justify-self: end;
  }
  .mast-rule {
    height: 6px;
    background: var(--accent);
    margin-top: clamp(0.8rem, 2vw, 1.4rem);
  }
  .mast-grid {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(1.2rem, 3vw, 2rem);
    border-bottom: 2px solid var(--line);
  }
  @media (min-width: 900px) {
    .mast-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: 3rem;
    }
  }
  .lede {
    font-size: clamp(1.1rem, 2.1vw, 1.6rem);
    line-height: 1.28;
    font-weight: 500;
    letter-spacing: -0.02em;
    max-width: 32ch;
    text-wrap: pretty;
  }
  .facts {
    display: grid;
    align-content: start;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--hair);
  }
  .facts dt { color: var(--dim); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.625rem; }
  .facts dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }
  .facts a { color: var(--accent); }

  /* -------------------------------------------------------------- sheets */
  .sheet {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3.5rem) var(--pad);
    border-bottom: 1px solid var(--hair);
    display: grid;
    gap: 1.2rem;
  }
  @media (min-width: 900px) {
    .sheet {
      grid-template-columns: 9rem 1fr;
      gap: 3rem;
    }
    .sheet-label { position: sticky; top: 4rem; align-self: start; }
  }
  .sheet-body { display: grid; gap: 1.4rem; }
  .loud {
    font-size: clamp(1.9rem, 5.2vw, 3.6rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-weight: 800;
    text-transform: uppercase;
    margin: 0;
    text-wrap: balance;
  }
  .cols { display: grid; gap: 1rem; color: var(--ink-2); }
  @media (min-width: 860px) { .cols { grid-template-columns: repeat(3, 1fr); gap: 1.8rem; } }
  .counter {
    border-top: 1px solid var(--hair);
    padding-top: 0.9rem;
    color: var(--dim);
    max-width: var(--read);
    display: grid;
    gap: 0.35rem;
    font-size: 0.9375rem;
  }

  /* ------------------------------------------------------------- entries */
  .entry {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3.5rem) var(--pad);
    border-bottom: 1px solid var(--hair);
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .entry { grid-template-columns: 9rem 1fr; gap: 3rem; }
  }
  .entry-num {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 0.8;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.05em;
  }
  .entry-body { display: grid; gap: 1rem; min-width: 0; }
  .entry-head { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .entry-head h2 {
    font-size: clamp(1.8rem, 4.4vw, 3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.038em;
    line-height: 0.98;
    margin: 0;
  }
  .st {
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    padding: 0.1rem 0.4rem;
    white-space: nowrap;
  }
  .st-live { color: var(--accent); }
  .st-building, .st-ongoing, .st-delivered { color: var(--dim); }
  .tag {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .beats { display: grid; gap: 1.4rem; }
  @media (min-width: 860px) {
    .beats { grid-template-columns: 1fr 1fr; gap: 1.6rem 2.5rem; }
    .beats .wide { grid-column: 1 / -1; }
  }
  .beats > div { display: grid; gap: 0.5rem; align-content: start; }
  .beats p, .beats ul { color: var(--ink-2); max-width: var(--read); }
  .beats ul { display: grid; gap: 0.28rem; list-style: none; padding: 0; }
  .beats li { padding-left: 1rem; position: relative; }
  .beats li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    background: var(--accent);
  }
  .calls { display: grid; gap: 1rem; }
  @media (min-width: 900px) { .calls { grid-template-columns: 1fr 1fr; gap: 1.6rem; } }
  .call { border-top: 3px solid var(--ink); padding-top: 0.7rem; display: grid; gap: 0.4rem; }
  .call h3 {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
    color: var(--ink);
  }
  .out-text { color: var(--ink) !important; font-size: 1.05rem; max-width: 46rem !important; }
  .stackline {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
    border-top: 1px solid var(--hair);
    padding-top: 0.7rem;
  }

  .minis { display: grid; gap: 1.6rem; }
  @media (min-width: 820px) { .minis { grid-template-columns: 1fr 1fr; } }
  .mini { display: grid; gap: 0.45rem; align-content: start; border-top: 3px solid var(--ink); padding-top: 0.8rem; }
  .mini h3 { font-size: 1.2rem; font-weight: 800; text-transform: uppercase; letter-spacing: -0.03em; margin: 0; }
  .mini p { color: var(--ink-2); font-size: 0.9375rem; }
  .inline-call strong { color: var(--ink); }

  .sg { display: grid; gap: 0.4rem; border-top: 1px solid var(--hair); padding-top: 0.8rem; }
  .sg h3 {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin: 0;
  }
  .items { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-2); line-height: 1.85; }
  .note { color: var(--dim); font-size: 0.875rem; max-width: var(--read); }

  .record { display: grid; list-style: none; padding: 0; margin: 0; }
  .record li { display: grid; gap: 0.1rem 2rem; padding: 0.75rem 0; border-top: 1px solid var(--hair); }
  @media (min-width: 640px) { .record li { grid-template-columns: 11rem 1fr; } }
  .when {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
    padding-top: 0.25rem;
  }
  .what { display: grid; gap: 0.05rem; }
  .what strong { font-size: 1rem; letter-spacing: -0.015em; }
  .what span { color: var(--ink-2); font-size: 0.9375rem; }
  .what .det { color: var(--dim); font-size: 0.875rem; }

  .colophon {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(3rem, 8vw, 6rem) var(--pad);
    display: grid;
    gap: 1.2rem;
    border-top: 6px solid var(--accent);
  }
  .links { display: flex; flex-wrap: wrap; gap: 1.6rem; font-family: var(--mono); font-size: 0.9375rem; }
  .links a { color: var(--accent); text-underline-offset: 4px; }

  .foot {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.2rem var(--pad) 3rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 2px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .foot a { color: var(--accent); }

  .verify-link {
    color: var(--accent, currentColor);
    text-underline-offset: 3px;
    font-weight: 600;
    white-space: nowrap;
  }
  .verify-link:hover { filter: brightness(1.15); }

  .role-hl {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }
  .role-hl li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.875rem;
    color: var(--ink-2, currentColor);
    line-height: 1.5;
  }
  .role-hl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--accent, currentColor);
  }

  /* Portrait beside the contact heading — a face where someone decides to write. */
  .portrait {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent, currentColor);
    flex: none;
  }
  /* Product screenshots. Phone-shaped, so they scroll rather than squash. */
  .shots {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
    margin-block: 0.3rem;
    scroll-snap-type: x mandatory;
  }
  .shots img {
    width: clamp(140px, 26vw, 210px);
    height: auto;
    flex: none;
    border-radius: 12px;
    scroll-snap-align: start;
    background: var(--raise, transparent);
  }

  .mast-claim {
    font-size: clamp(1.4rem, 3.2vw, 2.2rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    font-weight: 800;
    text-transform: uppercase;
    max-width: 20ch;
    margin-bottom: 0.7rem;
    text-wrap: balance;
  }
</style>
