---
import Base from '../../../layouts/Base.astro';
import TechWall from '../../../components/TechWall.astro';
import TechRow from '../../../components/TechRow.astro';
import ContactSwitch from '../../../components/ContactSwitch.astro';
import { LANGS, t, tl, OTHER_LANG, LANG_LABEL, path , asset} from '../../../i18n/types';
import type { Lang } from '../../../i18n/types';
import { ui } from '../../../i18n/ui';
import { profile } from '../../../data/profile';
import { projects, leadProjects, supportingProjects, STATUS_LABEL, projectName } from '../../../data/projects';
import { stackGroups } from '../../../data/stack';
import { timeline, presentLabel } from '../../../data/timeline';
import { COARSE_TIMELINE_DATES } from '../../../data/config';
import '../../../styles/reset.css';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const other = OTHER_LANG[lang];
const altHref = path(base, other, 'signal');
const indexHref = path(base, lang);

const title = `${profile.name}, ${t(profile.title, lang)}`;

/**
 * The hero readout has to be defensible in an interview, so the numbers come
 * from the project data rather than being typed in. `infra-ops` and the client
 * engagements are work, not products of his own, so they are excluded.
 */
const OWN_PRODUCTS = ['luxura', 'mate', 'femi', 'storia'];
const productCount = projects.filter((p) => OWN_PRODUCTS.includes(p.id)).length;
const liveCount = projects.filter((p) => p.status === 'live').length;
---

<Base
  lang={lang}
  title={title}
  description={t(profile.summary, lang)}
  slug="signal"
  themeColor="#0C1017"
>
  <a class="skip" href="#main">{t(ui.skipToContent, lang)}</a>

  <header class="bar">
    <div class="bar-in">
      <a class="mark" href={indexHref}>
        <span class="dot" aria-hidden="true"></span>
        <span>{profile.name}</span>
      </a>
      <nav class="bar-nav">
        <a href="#work">{t(ui.work, lang)}</a>
        <a href="#approach">{t(ui.about, lang)}</a>
        <a href="#stack">{t(ui.stack, lang)}</a>
        <a href="#record">{t(ui.timeline, lang)}</a>
        <a href="#contact">{t(ui.contact, lang)}</a>
      </nav>
      <div class="bar-tools">
        <a class="lang" href={altHref} hreflang={other} lang={other}>{LANG_LABEL[other]}</a>
        <button class="tog" data-theme-toggle type="button">
          <span class="visually-hidden">{t(ui.toggleTheme, lang)}</span>
          <span aria-hidden="true">◐</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ===================================================== HERO ===== -->
    <section class="hero">
      <canvas id="graph" aria-hidden="true"></canvas>
      <div class="hero-in shell">
        <p class="eyebrow">
          {t(profile.title, lang)} · {t(profile.experience, lang)} · {t(profile.location, lang)}
        </p>
        <h1 data-wipe>{t(profile.positioning, lang)}</h1>
        <p class="hero-lede">{t(profile.lede, lang)}</p>
        <ul class="chips">
          {tl(profile.fitFor, lang).map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <div class="readout shell">
        <div>
          <span>{t(ui.yearsShipping, lang)}</span>
          <b><span data-count="8" data-suffix="+">0</span></b>
        </div>
        {/* Counts derive from the data so they cannot drift from the content.
            Products built end to end: Luxura, Mate, Femi, Storia. In
            production: Luxura alone. */}
        <div>
          <span>{lang === 'es' ? 'Productos propios' : 'Products built'}</span>
          <b><span data-count={productCount}>0</span></b>
        </div>
        <div>
          <span>{lang === 'es' ? 'En producción' : 'In production'}</span>
          <b><span data-count={liveCount}>0</span></b>
        </div>
        <div><span>{t(ui.basedIn, lang)}</span><b>Bogotá · UTC−5</b></div>
      </div>
    </section>

    <!-- ================================================= APPROACH ===== -->
    <section id="approach" class="shell band">
      <div class="head">
        <p class="eyebrow">{t(ui.howIWork, lang)}</p>
        <span class="fill" data-draw></span>
      </div>
      <div class="approach" data-camera>
        <div>
          <h2>{t(profile.thesis.lead, lang)}</h2>
          {tl(profile.thesis.body, lang).map((p) => <p class="body">{p}</p>)}
        </div>
      </div>
    </section>

    <!-- ===================================================== WORK ===== -->
    <section id="work" class="shell band">
      <div class="head">
        <p class="eyebrow">{t(ui.leadWork, lang)}</p>
        <span class="fill" data-draw></span>
      </div>

      {
        leadProjects.map((p) => (
          <article class="case spot">
            <div class="case-bar">
              <h3>{projectName(p, lang)}</h3>
              <span class={`status s-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
            </div>
            <p class="tagline">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              {p.shots && (
                <div class="shots">
                  {p.shots.map((sh) => (
                    <img src={asset(base, sh.src)} alt={t(sh.alt, lang)} loading="lazy" decoding="async" />
                  ))}
                </div>
              )}

            <dl class="meta">
              <div>
                <dt>{t(ui.role, lang)}</dt>
                <dd>{t(p.role, lang)}</dd>
              </div>
              <div>
                <dt>{t(ui.period, lang)}</dt>
                <dd>{p.period}</dd>
              </div>
            </dl>

            <div class="beats" data-stagger>
              <div class="beat">
                <p class="eyebrow">{t(ui.theProblem, lang)}</p>
                <p class="body">{t(p.problem, lang)}</p>
              </div>

              <div class="beat">
                <p class="eyebrow">{t(ui.whatIBuilt, lang)}</p>
                <ul class="ticks">
                  {tl(p.built, lang).map((b) => <li>{b}</li>)}
                </ul>
              </div>

              <div class="beat">
                <p class="eyebrow">
                  {p.decisions.length > 1 ? t(ui.theDecisions, lang) : t(ui.theDecision, lang)}
                </p>
                {p.decisions.map((d) => (
                  <div class="decision">
                    <h4>{t(d.title, lang)}</h4>
                    <p class="body">{t(d.body, lang)}</p>
                  </div>
                ))}
              </div>

              <div class="beat">
                <p class="eyebrow">{t(ui.theOutcome, lang)}</p>
                <p class="body">{t(p.outcome, lang)}</p>
              </div>
            </div>

            <TechRow items={p.stack} />
          </article>
        ))
      }
    </section>

    <!-- =============================================== SUPPORTING ===== -->
    <section class="shell band">
      <div class="head">
        <p class="eyebrow">{t(ui.supportingWork, lang)}</p>
        <span class="fill" data-draw></span>
      </div>
      <div class="minis" data-stagger>
        {
          supportingProjects.map((p) => (
            <article class="mini spot">
              <div class="mini-bar">
                <h3>{projectName(p, lang)}</h3>
                <span class={`status s-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              </div>
              <p class="tagline">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              <p class="body">{t(p.problem, lang)}</p>
              <div class="decision compact">
                <h4>{t(p.decisions[0].title, lang)}</h4>
                <p class="body">{t(p.decisions[0].body, lang)}</p>
              </div>
              <TechRow items={p.stack} />
            </article>
          ))
        }
      </div>
    </section>

    <!-- ==================================================== STACK ===== -->
    <section id="stack" class="shell band">
      <div class="head">
        <p class="eyebrow">{t(ui.whatIUse, lang)}</p>
      <TechWall />
        <span class="fill" data-draw></span>
      </div>
      <div class="stacks" data-stagger>
        {
          stackGroups.map((g) => (
            <div class="sgroup">
              <h3>{t(g.label, lang)}</h3>
              <ul class="tech">
                {g.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
              {g.note && <p class="note">{t(g.note, lang)}</p>}
            </div>
          ))
        }
      </div>
    </section>

    <!-- =================================================== RECORD ===== -->
    <section id="record" class="shell band">
      <div class="head">
        <p class="eyebrow">{t(ui.timeline, lang)}</p>
        <span class="fill" data-draw></span>
      </div>
      <ol class="record">
        {
          timeline.map((e) => (
            <li>
              <span class="when">
                {COARSE_TIMELINE_DATES
                  ? e.yearsOnly
                  : `${e.from} to ${e.to === 'Present' ? t(presentLabel, lang) : e.to}`}
              </span>
              <span class="what">
                <strong>{t(e.role, lang)}</strong>
                <span class="org">{e.org}</span>
                {e.detail && <span class="det">{t(e.detail, lang)}</span>}{e.highlights && (<ul class="role-hl">{tl(e.highlights, lang).map((h) => <li>{h}</li>)}</ul>)}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ================================================== CONTACT ===== -->
    <section id="contact" class="shell band">
      <div class="cta spot" data-camera>
        <div class="contact-id"><img class="portrait" src={asset(base, profile.photo)} alt={t(profile.photoAlt, lang)} width="72" height="72" loading="lazy" />
        <p class="eyebrow">{t(ui.getInTouch, lang)}</p></div>
        {t(ui.contactLede, lang) && <h2>{t(ui.contactLede, lang)}</h2>}
      <ContactSwitch lang={lang} />
      </div>
    </section>
  </main>

  <footer class="foot shell">
    <span>{profile.name} · {t(profile.location, lang)}</span>
    <span><a href={indexHref}>{t(ui.backToIndex, lang)}</a></span>
  </footer>
</Base>

<style>
  :root {
    --ground: #e9ebef;
    --raise: #f5f6f8;
    --sunk: #dde1e7;
    --ink: #10151d;
    --ink-2: #3a4453;
    --dim: #6b7787;
    --line: #c9cfd8;
    --line-soft: #d8dde4;
    --signal: #b4700a;
    /* Shared components read --accent; Signal calls it --signal. */
    --accent: #b4700a;
    --signal-flat: #f0a423;
    --trace: #0e6f80;
    --good: #2c6e4a;
    --focus: #b4700a;

    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;

    --shell: 72rem;
    --read: 38rem;
    --pad: clamp(1.15rem, 4vw, 2.75rem);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #0c1017;
      --raise: #131924;
      --sunk: #080b11;
      --ink: #d8dee7;
      --ink-2: #a3aebe;
      --dim: #6b7787;
      --line: #232c3a;
      --line-soft: #1a222e;
      --signal: #f0a423;
      /* Shared components read --accent; Signal calls it --signal. */
      --accent: #f0a423;
      --signal-flat: #f0a423;
      --trace: #56c7d6;
      --good: #5fbf8b;
      --focus: #f0a423;
    }
  }
  :global(:root[data-theme='dark']) {
    --ground: #0c1017;
    --raise: #131924;
    --sunk: #080b11;
    --ink: #d8dee7;
    --ink-2: #a3aebe;
    --dim: #6b7787;
    --line: #232c3a;
    --line-soft: #1a222e;
    --signal: #f0a423;
    /* Shared components read --accent; Signal calls it --signal. */
    --accent: #f0a423;
    --signal-flat: #f0a423;
    --trace: #56c7d6;
    --good: #5fbf8b;
    --focus: #f0a423;
  }
  :global(:root[data-theme='light']) {
    --ground: #e9ebef;
    --raise: #f5f6f8;
    --sunk: #dde1e7;
    --ink: #10151d;
    --ink-2: #3a4453;
    --dim: #6b7787;
    --line: #c9cfd8;
    --line-soft: #d8dde4;
    --signal: #b4700a;
    /* Shared components read --accent; Signal calls it --signal. */
    --accent: #b4700a;
    --signal-flat: #f0a423;
    --trace: #0e6f80;
    --good: #2c6e4a;
    --focus: #b4700a;
  }

  :global(body) {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.62;
  }

  .shell {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  h1 {
    /* The positioning statement is one long sentence, so it needs a calmer
       size and a wider measure than a short headline would. */
    font-size: clamp(1.45rem, 2.5vw, 2.15rem);
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.018em;
    text-wrap: pretty;
    max-width: 40ch;
  }
  h2 {
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    line-height: 1.22;
    font-weight: 600;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  h3 {
    font-size: 1.15rem;
    font-weight: 650;
    line-height: 1.3;
  }
  h4 {
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.4;
    margin: 0;
  }
  .body {
    color: var(--ink-2);
    max-width: var(--read);
  }
  .body + .body {
    margin-top: 0.75rem;
  }

  /* ---------------------------------------------------------- top bar */
  .bar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar-in {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 0.6rem var(--pad);
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .dot {
    width: 7px;
    height: 7px;
    background: var(--signal);
    border-radius: 50%;
    animation: pulse 2.6s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.72);
    }
  }
  .bar-nav {
    display: flex;
    gap: 1.05rem;
    margin-inline-start: auto;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .bar-nav a {
    color: var(--dim);
    text-decoration: none;
  }
  .bar-nav a:hover {
    color: var(--signal);
  }
  .bar-tools {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .lang,
  .tog {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--dim);
    text-decoration: none;
    border: 1px solid var(--line);
    padding: 0.2rem 0.5rem;
  }
  .lang:hover,
  .tog:hover {
    color: var(--signal);
    border-color: var(--signal);
  }

  /* ------------------------------------------------------------- hero */
  .hero {
    position: relative;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  #graph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    /* Fade the graph out from the left so it never competes with the
       headline sitting on top of it. */
    -webkit-mask-image: linear-gradient(100deg, transparent 8%, #000 62%);
    mask-image: linear-gradient(100deg, transparent 8%, #000 62%);
  }
  .hero-in {
    position: relative;
    padding-block: clamp(3.5rem, 11vw, 7rem) clamp(2rem, 5vw, 3rem);
    display: grid;
    gap: 1.4rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chips li {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--raise) 80%, transparent);
    padding: 0.22rem 0.5rem;
  }
  .case,
  .mini,
  .cta {
    --spot-color: var(--signal);
  }

  .readout {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
    padding-block: 0.65rem;
    border-top: 1px solid var(--line-soft);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .readout div {
    display: flex;
    gap: 0.5rem;
  }
  .readout span {
    color: var(--dim);
  }
  .readout b {
    color: var(--signal);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    font-size: 0.9375rem;
  }

  /* ------------------------------------------------------------ bands */
  .band {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }
  .head .fill {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .approach {
    display: grid;
    gap: 1.6rem;
  }
  @media (min-width: 900px) {
    .approach {
      grid-template-columns: 1.4fr 0.85fr;
      align-items: start;
    }
  }
  .approach h2 {
    margin-bottom: 1rem;
  }
  .tradeoff {
    border-left: 2px solid var(--signal);
    padding: 0.9rem 1.1rem;
    background: var(--raise);
    display: grid;
    gap: 0.6rem;
  }
  .tradeoff p:last-child {
    color: var(--ink-2);
  }

  /* ------------------------------------------------------ case studies */
  .case {
    border: 1px solid var(--line);
    background: var(--raise);
    padding: clamp(1.1rem, 3vw, 1.9rem);
    display: grid;
    gap: 1.1rem;
  }
  .case + .case {
    margin-top: 1.5rem;
  }
  .case-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line-soft);
    padding-bottom: 0.7rem;
  }
  .tagline {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.8125rem;
    margin-top: -0.6rem;
  }
  .status {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.45rem;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .s-live {
    color: var(--good);
  }
  .s-building {
    color: var(--signal);
  }
  .s-ongoing {
    color: var(--trace);
  }
  .s-delivered {
    color: var(--dim);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
  }
  .meta div {
    display: flex;
    gap: 0.5rem;
  }
  .meta dt {
    color: var(--dim);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .meta dd {
    margin: 0;
    color: var(--ink-2);
  }

  .beats {
    display: grid;
    gap: 1.3rem;
  }
  .beat {
    display: grid;
    gap: 0.5rem;
  }
  .ticks {
    display: grid;
    gap: 0.35rem;
    max-width: var(--read);
  }
  .ticks li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--ink-2);
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 1px;
    background: var(--signal);
  }
  .decision {
    border: 1px solid var(--line-soft);
    border-left: 2px solid var(--trace);
    background: var(--ground);
    padding: 0.85rem 1rem;
    display: grid;
    gap: 0.45rem;
  }
  .decision + .decision {
    margin-top: 0.7rem;
  }
  .decision.compact {
    background: var(--raise);
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    border-top: 1px solid var(--line-soft);
    padding-top: 0.9rem;
  }
  .tech li {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--dim);
    border: 1px solid var(--line-soft);
    padding: 0.15rem 0.4rem;
  }

  /* --------------------------------------------------------- supporting */
  .minis {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 860px) {
    .minis {
      grid-template-columns: 1fr 1fr;
    }
  }
  .mini {
    border: 1px solid var(--line);
    background: var(--raise);
    padding: 1.1rem 1.2rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .mini-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .mini h3 {
    font-size: 1rem;
  }

  /* -------------------------------------------------------------- stack */
  .stacks {
    display: grid;
    gap: 1.2rem;
  }
  @media (min-width: 760px) {
    .stacks {
      grid-template-columns: 1fr 1fr;
    }
  }
  .sgroup {
    border: 1px solid var(--line);
    background: var(--raise);
    padding: 1rem 1.1rem;
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }
  .sgroup h3 {
    font-size: 0.8125rem;
    font-family: var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--signal);
    font-weight: 600;
  }
  .sgroup .tech {
    border-top: 0;
    padding-top: 0;
  }
  .note {
    font-size: 0.8125rem;
    color: var(--dim);
    border-top: 1px solid var(--line-soft);
    padding-top: 0.6rem;
  }

  /* ------------------------------------------------------------- record */
  .record {
    display: grid;
    gap: 0;
    border: 1px solid var(--line);
    background: var(--raise);
  }
  .record li {
    display: grid;
    gap: 0.2rem 1.5rem;
    grid-template-columns: 1fr;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--line-soft);
  }
  @media (min-width: 700px) {
    .record li {
      grid-template-columns: 12rem 1fr;
    }
  }
  .record li:last-child {
    border-bottom: 0;
  }
  .when {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }
  .what {
    display: grid;
    gap: 0.1rem;
  }
  .org {
    color: var(--ink-2);
    font-size: 0.875rem;
  }
  .det {
    color: var(--dim);
    font-size: 0.8125rem;
  }

  /* ------------------------------------------------------------ contact */
  .cta {
    border: 1px solid var(--signal);
    background: var(--raise);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    display: grid;
    gap: 1rem;
  }
  .cta .eyebrow {
    color: var(--signal);
  }
  .cta h2 {
    max-width: 26ch;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.3rem;
  }
  .btn {
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    background: var(--signal);
    color: var(--ground);
    font-weight: 600;
  }
  .btn.ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
    font-weight: 400;
  }
  .btn:hover {
    filter: brightness(1.08);
  }
  .btn.ghost:hover {
    border-color: var(--signal);
    color: var(--signal);
    filter: none;
  }

  .foot {
    border-top: 1px solid var(--line);
    padding-block: 1.6rem 2.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .foot a {
    color: var(--signal);
  }

  .verify-link {
    color: var(--accent, currentColor);
    text-underline-offset: 3px;
    font-weight: 600;
    white-space: nowrap;
  }
  .verify-link:hover { filter: brightness(1.15); }

  .role-hl {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }
  .role-hl li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.875rem;
    color: var(--ink-2, currentColor);
    line-height: 1.5;
  }
  .role-hl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--accent, currentColor);
  }

  .contact-id { display: flex; align-items: center; gap: 0.9rem; }

  /* Portrait beside the contact heading, a face where someone decides to write. */
  .portrait {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent, currentColor);
    flex: none;
  }
  /* Product screenshots. Phone-shaped, so they scroll rather than squash. */
  .shots {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
    margin-block: 0.3rem;
    scroll-snap-type: x mandatory;
  }
  .shots img {
    width: clamp(140px, 26vw, 210px);
    height: auto;
    flex: none;
    border-radius: 12px;
    scroll-snap-align: start;
    background: var(--raise, transparent);
  }

  .hero-lede {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.5;
    color: var(--ink-2, currentColor);
    max-width: 46ch;
    margin-top: 0.9rem;
    text-wrap: pretty;
  }
</style>

<script>
  // Hero node graph. Every node is a real project; the sweep is the only
  // decoration, and it exists to make the graph readable, not busy.
  const cv = document.getElementById('graph') as HTMLCanvasElement | null;
  if (cv) {
    const ctx = cv.getContext('2d');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Node = { x: number; y: number; r: number; label: string };
    const nodes: Node[] = [
      { x: 0.08, y: 0.34, r: 3.0, label: 'level60' },
      { x: 0.2, y: 0.66, r: 3.4, label: 'storia' },
      { x: 0.33, y: 0.26, r: 5.6, label: 'luxura' },
      { x: 0.45, y: 0.6, r: 4.4, label: 'mate' },
      { x: 0.57, y: 0.3, r: 4.2, label: 'femi' },
      { x: 0.69, y: 0.68, r: 3.0, label: 'infra' },
      { x: 0.81, y: 0.38, r: 3.2, label: 'growth' },
      { x: 0.92, y: 0.62, r: 2.6, label: 'clinic' },
    ];
    const edges: [number, number][] = [
      [0, 2], [1, 2], [2, 3], [2, 4], [3, 4],
      [2, 5], [5, 6], [2, 6], [6, 7], [1, 3],
    ];

    let palette = { ground: '#0C1017', ink: '#D8DEE7', dim: '#6B7787', line: '#232C3A', signal: '#F0A423', trace: '#56C7D6' };
    const readPalette = () => {
      const s = getComputedStyle(document.documentElement);
      const get = (n: string, f: string) => s.getPropertyValue(n).trim() || f;
      palette = {
        ground: get('--ground', palette.ground),
        ink: get('--ink', palette.ink),
        dim: get('--dim', palette.dim),
        line: get('--line', palette.line),
        signal: get('--signal-flat', palette.signal),
        trace: get('--trace', palette.trace),
      };
    };
    readPalette();
    new MutationObserver(readPalette).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readPalette);

    let visible = true;
    new IntersectionObserver(
      (es) => es.forEach((e) => (visible = e.isIntersecting)),
      { rootMargin: '80px' },
    ).observe(cv);

    let t = 0;
    const draw = () => {
      if (!ctx || !visible) {
        requestAnimationFrame(draw);
        return;
      }
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = cv.getBoundingClientRect();
      const w = Math.max(1, Math.round(rect.width * dpr));
      const h = Math.max(1, Math.round(rect.height * dpr));
      if (cv.width !== w || cv.height !== h) {
        cv.width = w;
        cv.height = h;
      }

      ctx.clearRect(0, 0, w, h);
      if (!reduce) t += 0.006;

      // hairline grid
      ctx.strokeStyle = palette.line;
      ctx.lineWidth = 1;
      ctx.globalAlpha = 0.45;
      for (let x = 0; x < w; x += 32 * dpr) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, h);
        ctx.stroke();
      }
      for (let y = 0; y < h; y += 32 * dpr) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      const sweep = ((t * 0.24) % 1) * w;

      // edges
      ctx.strokeStyle = palette.dim;
      ctx.lineWidth = dpr;
      ctx.globalAlpha = 0.4;
      for (const [a, b] of edges) {
        ctx.beginPath();
        ctx.moveTo(nodes[a].x * w, nodes[a].y * h);
        ctx.lineTo(nodes[b].x * w, nodes[b].y * h);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      // packets
      edges.forEach(([a, b], i) => {
        const p = (t * 0.4 + i * 0.13) % 1;
        const x = nodes[a].x * w + (nodes[b].x - nodes[a].x) * w * p;
        const y = nodes[a].y * h + (nodes[b].y - nodes[a].y) * h * p;
        ctx.fillStyle = palette.trace;
        ctx.globalAlpha = 0.8;
        ctx.beginPath();
        ctx.arc(x, y, 1.6 * dpr, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.globalAlpha = 1;

      // sweep line
      const g = ctx.createLinearGradient(sweep - 80 * dpr, 0, sweep, 0);
      g.addColorStop(0, 'rgba(0,0,0,0)');
      g.addColorStop(1, palette.signal);
      ctx.globalAlpha = 0.14;
      ctx.fillStyle = g;
      ctx.fillRect(sweep - 80 * dpr, 0, 80 * dpr, h);
      ctx.globalAlpha = 1;

      // nodes
      ctx.font = `${9 * dpr}px ${'ui-monospace, monospace'}`;
      for (const n of nodes) {
        const nx = n.x * w;
        const ny = n.y * h;
        const lit = Math.max(0, 1 - Math.abs(nx - sweep) / (70 * dpr));
        const r = n.r * dpr * (1 + lit * 0.5);
        if (lit > 0) {
          ctx.globalAlpha = lit * 0.22;
          ctx.fillStyle = palette.signal;
          ctx.beginPath();
          ctx.arc(nx, ny, r * 3.2, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        ctx.fillStyle = lit > 0.25 ? palette.signal : palette.ink;
        ctx.beginPath();
        ctx.arc(nx, ny, r, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 0.55;
        ctx.fillStyle = palette.dim;
        ctx.fillText(n.label, nx + r + 4 * dpr, ny + 3 * dpr);
        ctx.globalAlpha = 1;
      }

      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  }
</script>
