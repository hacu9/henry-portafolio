---
import Base from '../../../layouts/Base.astro';
import ContactSwitch from '../../../components/ContactSwitch.astro';
import { LANGS, t, tl, OTHER_LANG, LANG_LABEL, path , asset} from '../../../i18n/types';
import type { Lang } from '../../../i18n/types';
import { ui } from '../../../i18n/ui';
import { profile } from '../../../data/profile';
import { leadProjects, supportingProjects, STATUS_LABEL, projectName } from '../../../data/projects';
import { stackGroups } from '../../../data/stack';
import { timeline, presentLabel } from '../../../data/timeline';
import { COARSE_TIMELINE_DATES } from '../../../data/config';
import '../../../styles/reset.css';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
const other = OTHER_LANG[lang];
const altHref = path(base, other, 'kinetic');
const indexHref = path(base, lang);

/**
 * The hero word cycles through the same idea in both languages. This is the
 * mechanic the whole direction rests on, so the pairs are real vocabulary from
 * the work — not decoration.
 */
const morphWords: [string, string][] = [
  ['SHIPPED', 'ENTREGADO'],
  ['SYSTEMS', 'SISTEMAS'],
  ['DECISIONS', 'DECISIONES'],
  ['PRODUCTION', 'PRODUCCIÓN'],
  ['TRUST', 'CONFIANZA'],
];
const first = lang === 'es' ? morphWords[0][1] : morphWords[0][0];
---

<Base
  lang={lang}
  title={`${profile.name} — ${t(profile.title, lang)}`}
  description={t(profile.positioning, lang)}
  slug="kinetic"
  themeColor="#111014"
>
  <a class="skip" href="#main">{t(ui.skipToContent, lang)}</a>

  <header class="bar">
    <a class="mark" href={indexHref}>{profile.name}</a>
    <div class="tools">
      <a href={altHref} hreflang={other} lang={other}>{LANG_LABEL[other]}</a>
      <button data-theme-toggle type="button">
        <span class="visually-hidden">{t(ui.toggleTheme, lang)}</span>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </header>

  <main id="main">
    <!-- ===================================================== HERO -->
    <section class="hero">
      <div class="hero-stick">
        <p class="micro">{t(profile.title, lang)} — {t(profile.experience, lang)}</p>
        <h1 class="morph-line">
          <span class="visually-hidden">{t(profile.positioning, lang)}</span>
          <span id="morph" aria-hidden="true" data-words={JSON.stringify(morphWords)}>{first}</span>
        </h1>
        <p class="hero-sub">{t(profile.positioning, lang)}</p>
        <p class="micro loc">
          {t(profile.location, lang)} · {t(profile.workingStyle, lang)}
        </p>
      </div>
    </section>

    <!-- The stack as a running strip. Grid-breaking rhythm, per Uncommon. -->
    <div class="marquee strip" aria-hidden="true">
      <div>
        {
          Array.from({ length: 2 }).map(() => (
            <>
              {['Next.js', 'React Native', 'LangGraph', 'PostgreSQL', 'Capacitor', 'Azure', 'Docker', 'Hetzner', 'TypeScript', 'Expo'].map((s) => (
                <span>{s}</span>
              ))}
            </>
          ))
        }
      </div>
    </div>

    <!-- ================================================= APPROACH -->
    <section id="approach" class="type-band" data-camera>
      <p class="micro">{t(ui.howIWork, lang)}</p>
      <h2 class="huge" data-wipe>{t(profile.thesis.lead, lang)}</h2>
      <div class="cols" data-stagger>
        {tl(profile.thesis.body, lang).map((p) => <p>{p}</p>)}
      </div>
      <p class="aside">
        <span class="micro">{t(ui.theTradeoff, lang)}</span>
        {t(profile.thesis.tradeoff, lang)}
      </p>
    </section>

    <!-- ===================================================== WORK -->
    <section id="work">
      <p class="micro pad">{t(ui.leadWork, lang)}</p>
      {
        leadProjects.map((p) => (
          <article class="case spot">
            <header class="case-top">
              <h2 class="huge stretch" data-wipe>{projectName(p, lang)}</h2>
              <p class="case-tag" data-rise>
                {t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}
                <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              </p>
              {p.shots && (
                <div class="shots">
                  {p.shots.map((sh) => (
                    <img src={asset(base, sh.src)} alt={t(sh.alt, lang)} loading="lazy" decoding="async" />
                  ))}
                </div>
              )}
            </header>

            <div class="grid" data-stagger>
              <div class="cell">
                <p class="micro">{t(ui.theProblem, lang)}</p>
                <p>{t(p.problem, lang)}</p>
              </div>
              <div class="cell">
                <p class="micro">{t(ui.whatIBuilt, lang)}</p>
                <ul>
                  {tl(p.built, lang).map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
              <div class="cell wide">
                <p class="micro">
                  {p.decisions.length > 1 ? t(ui.theDecisions, lang) : t(ui.theDecision, lang)}
                </p>
                {p.decisions.map((d) => (
                  <div class="call">
                    <h3>{t(d.title, lang)}</h3>
                    <p>{t(d.body, lang)}</p>
                  </div>
                ))}
              </div>
              <div class="cell wide">
                <p class="micro">{t(ui.theOutcome, lang)}</p>
                <p class="out">{t(p.outcome, lang)}</p>
              </div>
            </div>

            <p class="stack-line">{p.stack.join('  ·  ')}</p>
          </article>
        ))
      }
    </section>

    <!-- =============================================== SUPPORTING -->
    <section class="type-band">
      <p class="micro">{t(ui.supportingWork, lang)}</p>
      <div class="minis" data-stagger>
        {
          supportingProjects.map((p) => (
            <article class="mini">
              <h3>
                {projectName(p, lang)}
                <span class={`st st-${p.status}`}>{t(STATUS_LABEL[p.status], lang)}</span>
              </h3>
              <p class="case-tag plain">{t(p.tagline, lang)}{p.url && (<>{' · '}<a class="verify-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel ? t(p.urlLabel, lang) : t(ui.verify, lang)} ↗</a></>)}</p>
              <p>{t(p.problem, lang)}</p>
              <p class="inline-call">
                <strong>{t(p.decisions[0].title, lang)}.</strong> {t(p.decisions[0].body, lang)}
              </p>
              <p class="stack-line small">{p.stack.join('  ·  ')}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ==================================================== STACK -->
    <section class="type-band">
      <p class="micro">{t(ui.whatIUse, lang)}</p>
      {
        stackGroups.map((g) => (
          <div class="sgroup">
            <h3>{t(g.label, lang)}</h3>
            <p class="stack-line big">{g.items.join('  ·  ')}</p>
            {g.note && <p class="note">{t(g.note, lang)}</p>}
          </div>
        ))
      }
    </section>

    <!-- =================================================== RECORD -->
    <section class="type-band">
      <p class="micro">{t(ui.timeline, lang)}</p>
      <ol class="record">
        {
          timeline.map((e) => (
            <li>
              <span class="when">
                {COARSE_TIMELINE_DATES
                  ? e.yearsOnly
                  : `${e.from} — ${e.to === 'Present' ? t(presentLabel, lang) : e.to}`}
              </span>
              <span class="what">
                <strong>{t(e.role, lang)}</strong>
                <span>{e.org}</span>
                {e.detail && <span class="det">{t(e.detail, lang)}</span>}{e.highlights && (<ul class="role-hl">{tl(e.highlights, lang).map((h) => <li>{h}</li>)}</ul>)}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ================================================== CONTACT -->
    <section id="contact" class="close" data-camera>
      <div class="contact-id"><img class="portrait" src={asset(base, profile.photo)} alt={t(profile.photoAlt, lang)} width="72" height="72" loading="lazy" />
        <p class="micro">{t(ui.getInTouch, lang)}</p></div>
      {t(ui.contactLede, lang) && <h2 class="huge stretch" data-wipe>{t(ui.contactLede, lang)}</h2>}
      <ContactSwitch lang={lang} />
    </section>
  </main>

  <footer class="foot">
    <span>{profile.name} · {t(profile.location, lang)}</span>
    <a href={indexHref}>{t(ui.backToIndex, lang)}</a>
  </footer>
</Base>

<style>
  :root {
    --ground: #f7f5f2;
    --raise: #ffffff;
    --ink: #111014;
    --ink-2: #45414c;
    --dim: #837d8c;
    --line: #ddd7d1;
    --accent: #b5122e;
    --focus: #b5122e;

    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;

    --shell: 70rem;
    --read: 34rem;
    --pad: clamp(1.15rem, 4vw, 3rem);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #111014;
      --raise: #191720;
      --ink: #f2eee9;
      --ink-2: #b6afbd;
      --dim: #7d7686;
      --line: #2a2733;
      --accent: #ff5c74;
      --focus: #ff5c74;
    }
  }
  :global(:root[data-theme='dark']) {
    --ground: #111014;
    --raise: #191720;
    --ink: #f2eee9;
    --ink-2: #b6afbd;
    --dim: #7d7686;
    --line: #2a2733;
    --accent: #ff5c74;
    --focus: #ff5c74;
  }
  :global(:root[data-theme='light']) {
    --ground: #f7f5f2;
    --raise: #ffffff;
    --ink: #111014;
    --ink-2: #45414c;
    --dim: #837d8c;
    --line: #ddd7d1;
    --accent: #b5122e;
    --focus: #b5122e;
  }

  :global(body) {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.6;
  }

  .micro {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* Typography is the entire design here, so the scale runs hot. */
  .huge {
    font-size: clamp(2.4rem, 9vw, 6.5rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
    font-weight: 800;
    text-wrap: balance;
  }
  .stretch {
    font-stretch: 105%;
    text-transform: uppercase;
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem var(--pad);
    background: color-mix(in srgb, var(--ground) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bar a {
    text-decoration: none;
  }
  .mark {
    font-weight: 700;
  }
  .tools {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    color: var(--dim);
  }
  .tools a:hover,
  .tools button:hover {
    color: var(--accent);
  }

  /* ------------------------------------------------------------ hero */
  /* Tall enough that scrolling through it advances the word — each pair owns
     a slice of the height. The copy sticks while the words change. */
  .hero {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--pad);
    min-height: 220svh;
  }
  .hero-stick {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: 1.4rem;
    padding-block: clamp(3rem, 10vh, 6rem);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      min-height: 0;
    }
    .hero-stick {
      position: static;
      min-height: 0;
    }
  }
  .morph-line {
    margin: 0;
    min-height: 0.96em;
  }
  #morph {
    display: flex;
    flex-wrap: wrap;
    font-size: clamp(3rem, 15vw, 11rem);
    line-height: 0.86;
    letter-spacing: -0.05em;
    font-weight: 800;
    color: var(--accent);
    text-transform: uppercase;
  }
  #morph :global(span) {
    display: inline-block;
    transform-origin: 50% 88%;
    will-change: transform, opacity;
  }
  .hero-sub {
    font-size: clamp(1.15rem, 2.6vw, 1.7rem);
    line-height: 1.34;
    max-width: 30ch;
    font-weight: 500;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .loc {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .strip {
    --marquee-gap: 2.5rem;
    --marquee-speed: 46s;
    border-block: 1px solid var(--line);
    padding-block: 0.65rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .strip span {
    white-space: nowrap;
  }

  .case {
    --spot-color: var(--accent);
  }

  /* ------------------------------------------------------ type band */
  .type-band {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(3rem, 9vw, 6rem) var(--pad);
    border-top: 1px solid var(--line);
    display: grid;
    gap: 1.5rem;
  }
  .cols {
    display: grid;
    gap: 1rem;
    color: var(--ink-2);
  }
  @media (min-width: 820px) {
    .cols {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
  .aside {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    color: var(--dim);
    max-width: var(--read);
    display: grid;
    gap: 0.4rem;
    font-size: 0.9375rem;
  }

  /* ------------------------------------------------------------ case */
  .pad {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--pad);
    padding-top: clamp(3rem, 9vw, 6rem);
  }
  .case {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 3.5rem) var(--pad);
    display: grid;
    gap: 1.8rem;
  }
  .case + .case {
    border-top: 1px solid var(--line);
  }
  .case-top {
    display: grid;
    gap: 0.6rem;
  }
  .case-tag {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--dim);
    display: flex;
    gap: 0.8rem;
    align-items: center;
    flex-wrap: wrap;
    letter-spacing: 0.04em;
  }
  .case-tag.plain {
    font-size: 0.6875rem;
  }
  .st {
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    padding: 0.1rem 0.35rem;
    white-space: nowrap;
  }
  .st-live {
    color: #22855c;
  }
  .st-building {
    color: var(--accent);
  }
  .st-ongoing,
  .st-delivered {
    color: var(--dim);
  }
  @media (prefers-color-scheme: dark) {
    .st-live {
      color: #57d39b;
    }
  }

  .grid {
    display: grid;
    gap: 1.6rem;
  }
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 3rem;
    }
    .cell.wide {
      grid-column: 1 / -1;
    }
  }
  .cell {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    color: var(--ink-2);
  }
  .cell p,
  .cell ul {
    max-width: var(--read);
  }
  .cell ul {
    display: grid;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
  }
  .cell ul li::before {
    content: '— ';
    color: var(--accent);
  }
  .call {
    border-top: 1px solid var(--line);
    padding-top: 0.9rem;
    display: grid;
    gap: 0.4rem;
    max-width: 46rem;
  }
  .call + .call {
    margin-top: 0.6rem;
  }
  .call h3 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ink);
  }
  .out {
    font-size: 1.05rem;
    color: var(--ink);
    max-width: 46rem;
  }
  .stack-line {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--dim);
    text-transform: lowercase;
    border-top: 1px solid var(--line);
    padding-top: 0.8rem;
  }
  .stack-line.small {
    border: 0;
    padding-top: 0.3rem;
  }
  .stack-line.big {
    font-size: 0.875rem;
    border: 0;
    padding-top: 0;
    color: var(--ink-2);
    letter-spacing: 0.02em;
  }

  /* ----------------------------------------------------------- minis */
  .minis {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 800px) {
    .minis {
      grid-template-columns: 1fr 1fr;
    }
  }
  .mini {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    color: var(--ink-2);
  }
  .mini h3 {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ink);
    display: flex;
    gap: 0.7rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .inline-call strong {
    color: var(--ink);
  }

  .sgroup {
    display: grid;
    gap: 0.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
  .sgroup h3 {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
  }
  .note {
    color: var(--dim);
    font-size: 0.875rem;
    max-width: var(--read);
  }

  /* ---------------------------------------------------------- record */
  .record {
    display: grid;
    list-style: none;
    padding: 0;
  }
  .record li {
    display: grid;
    gap: 0.1rem 2rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .record li {
      grid-template-columns: 11rem 1fr;
    }
  }
  .when {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
    padding-top: 0.3rem;
  }
  .what {
    display: grid;
    gap: 0.05rem;
  }
  .what strong {
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .what span {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .what .det {
    color: var(--dim);
    font-size: 0.875rem;
  }

  /* ----------------------------------------------------------- close */
  .close {
    max-width: var(--shell);
    margin-inline: auto;
    padding: clamp(4rem, 12vw, 8rem) var(--pad);
    border-top: 1px solid var(--line);
    display: grid;
    gap: 1.4rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    font-family: var(--mono);
    font-size: 0.9375rem;
  }
  .links a {
    color: var(--accent);
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }

  .foot {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.5rem var(--pad) 3rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .foot a {
    color: var(--accent);
  }

  .verify-link {
    color: var(--accent, currentColor);
    text-underline-offset: 3px;
    font-weight: 600;
    white-space: nowrap;
  }
  .verify-link:hover { filter: brightness(1.15); }

  .role-hl {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }
  .role-hl li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.875rem;
    color: var(--ink-2, currentColor);
    line-height: 1.5;
  }
  .role-hl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--accent, currentColor);
  }

  .contact-id { display: flex; align-items: center; gap: 0.9rem; }

  /* Portrait beside the contact heading — a face where someone decides to write. */
  .portrait {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent, currentColor);
    flex: none;
  }
  /* Product screenshots. Phone-shaped, so they scroll rather than squash. */
  .shots {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
    margin-block: 0.3rem;
    scroll-snap-type: x mandatory;
  }
  .shots img {
    width: clamp(140px, 26vw, 210px);
    height: auto;
    flex: none;
    border-radius: 12px;
    scroll-snap-align: start;
    background: var(--raise, transparent);
  }
</style>

<script>
  // Mat Voyce's mechanic, properly: letters that stretch, snap and recombine
  // ON SCROLL. The earlier version ran on a timer, which reads as a loading
  // spinner rather than as a response to the reader.
  //
  // Two things are driven here:
  //   1. Scroll position through the hero advances the word.
  //   2. Scroll VELOCITY stretches the letters, so the type has mass.
  const host = document.getElementById('morph');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (host) {
    const pairs: [string, string][] = JSON.parse(host.dataset.words || '[]');
    const pageLang = document.documentElement.lang === 'es' ? 1 : 0;
    const hero = host.closest('.hero') as HTMLElement | null;

    let letters: HTMLElement[] = [];
    let currentKey = '';

    const render = (word: string) => {
      if (word === currentKey) return;
      currentKey = word;
      host.textContent = '';
      const frag = document.createDocumentFragment();
      letters = [...word].map((ch, i) => {
        const el = document.createElement('span');
        el.textContent = ch;
        if (!reduce) {
          el.style.opacity = '0';
          el.style.transform = 'translateY(.4em) scaleY(.35)';
          el.style.transition =
            `opacity .26s ease ${i * 0.028}s, transform .42s cubic-bezier(.2,.9,.2,1) ${i * 0.028}s`;
        }
        frag.appendChild(el);
        return el;
      });
      host.appendChild(frag);
      if (!reduce) {
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            for (const el of letters) {
              el.style.opacity = '1';
              el.style.transform = 'none';
            }
          }),
        );
      }
    };

    render(pairs[pageLang === 1 ? 0 : 0][pageLang]);

    if (!reduce && pairs.length) {
      let lastY = window.scrollY;
      let velocity = 0;

      const frame = () => {
        // Decay toward rest so the stretch settles instead of sticking.
        velocity *= 0.88;

        // Scroll position picks the word. The hero is tall enough that each
        // word owns a slice of it.
        if (hero) {
          const rect = hero.getBoundingClientRect();
          const span = rect.height - window.innerHeight;
          const progress = span > 0 ? Math.min(1, Math.max(0, -rect.top / span)) : 0;
          const step = Math.min(pairs.length * 2 - 1, Math.floor(progress * pairs.length * 2));
          const wordIndex = Math.floor(step / 2);
          // Alternate language as you descend: EN, ES, EN, ES…
          const side = step % 2 === 0 ? pageLang : pageLang === 0 ? 1 : 0;
          render(pairs[wordIndex][side]);
        }

        // Velocity stretches the letters vertically and shears them slightly.
        const v = Math.max(-1, Math.min(1, velocity / 60));
        if (Math.abs(v) > 0.001) {
          const sy = 1 + Math.abs(v) * 0.28;
          const sx = 1 - Math.abs(v) * 0.06;
          const skew = v * -4;
          for (let i = 0; i < letters.length; i++) {
            const el = letters[i];
            if (el.style.transition && el.style.opacity !== '1') continue;
            // Letters further along lag slightly, which is what makes it
            // read as a wave rather than a block scaling.
            const lag = 1 - (i / Math.max(1, letters.length)) * 0.35;
            el.style.transform = `scale(${sx}, ${1 + (sy - 1) * lag}) skewX(${skew * lag}deg)`;
          }
        }

        requestAnimationFrame(frame);
      };

      window.addEventListener(
        'scroll',
        () => {
          const y = window.scrollY;
          velocity = y - lastY;
          lastY = y;
        },
        { passive: true },
      );

      requestAnimationFrame(frame);
    }
  }
</script>
